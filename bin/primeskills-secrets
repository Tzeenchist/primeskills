#!/usr/bin/env python3
"""Register secrets the pre-push guard must never let leave the machine.

PS-092: a sudo password sat in two repositories' history for half a year, and
no pattern scanner would have caught it -- six digits under `*_PASS` has no
vendor format and no entropy. Only the owner knows which strings are secrets,
so the owner lists them here.

The file holds a length and a SHA-256 per secret, never the value: a list of
secrets in clear text would be the next leak. The guard hashes every window of
that length in the lines being pushed.

    primeskills-secrets add            # prompts, input hidden
    primeskills-secrets add --stdin    # one secret per line from stdin
    primeskills-secrets count          # how many are registered, by length
"""
import getpass
import hashlib
import os
import sys
from pathlib import Path

STORE = Path.home() / ".primeskills" / "secrets"
MIN_LEN = 6


def entries():
    if not STORE.is_file():
        return []
    out = []
    for line in STORE.read_text(encoding="utf-8").splitlines():
        length, _, digest = line.strip().partition(":")
        if length.isdigit() and len(digest) == 64:
            out.append((int(length), digest))
    return out


def add(values):
    known = set(entries())
    fresh = []
    for value in values:
        if len(value) < MIN_LEN:
            print(f"skipped: shorter than {MIN_LEN} characters would match "
                  f"ordinary text", file=sys.stderr)
            continue
        item = (len(value), hashlib.sha256(value.encode("utf-8")).hexdigest())
        if item not in known:
            known.add(item)
            fresh.append(item)
    if not fresh:
        print("nothing new to add")
        return 0
    STORE.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(STORE, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    with os.fdopen(fd, "a", encoding="utf-8") as f:
        for length, digest in fresh:
            f.write(f"{length}:{digest}\n")
    os.chmod(STORE, 0o600)
    print(f"added {len(fresh)}; {len(known)} registered in {STORE}")
    return 0


def main(argv):
    if not argv or argv[0] not in ("add", "count"):
        print(__doc__.strip().splitlines()[-3:], sep="\n")
        sys.exit("usage: primeskills-secrets add [--stdin] | count")
    if argv[0] == "count":
        by_len = {}
        for length, _ in entries():
            by_len[length] = by_len.get(length, 0) + 1
        total = sum(by_len.values())
        lengths = ", ".join(f"{n}×{k}" for k, n in sorted(by_len.items()))
        print(f"{total} registered" + (f" (length: {lengths})" if total else ""))
        return 0
    if "--stdin" in argv[1:]:
        values = [line.rstrip("\n") for line in sys.stdin if line.strip()]
    else:
        value = getpass.getpass("secret (hidden): ")
        if value != getpass.getpass("again: "):
            sys.exit("the two entries differ; nothing added")
        values = [value]
    return add(values)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
