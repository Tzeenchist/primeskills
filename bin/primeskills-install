#!/usr/bin/env python3
"""Link the skills into each agent, from one source of truth.

Nothing is copied: every agent points at skills/ in this repository, so an edit
here takes effect everywhere at once. Prints a plan by default; --apply does it.

Claude Code wants a real directory with the files linked inside it (that is how
gstack installs, and it keeps ref/ reachable). Codex and OpenCode take a symlink
to the directory. Kimi needs no links at all -- just the path in its config.
"""
import argparse
import json
import os
import shlex
import re
import shutil
import subprocess
import sys

if sys.version_info < (3, 11):  # tomllib, used to read Kimi's configuration
    raise SystemExit(f"primeskills-install needs Python 3.11 or newer; this is "
                     f"{sys.version.split()[0]}. The floor is `tomllib`.")

import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SKILLS = ROOT / "skills"
HOME = Path.home()
# A pin is a git worktree the agents read instead of the live working copy.
# Without one, editing a file here changes the behaviour of every agent
# immediately, including the session running right now -- which has already
# cost us twice: a test froze a wrong order, and a raised ceiling disarmed a
# fixture mid-run. The pinned tree installs itself, so every path it writes
# (links, hook commands, core pointer) names the pinned tree and stays
# consistent without a second notion of "root" inside this program.
PINNED = HOME / ".primeskills" / "pinned"
PIN_FILE = HOME / ".primeskills" / "pin.json"

TARGETS = {
    "claude": HOME / ".claude" / "skills",
    "codex": HOME / ".codex" / "skills",
    "opencode": HOME / ".config" / "opencode" / "skills",
    "cline": HOME / ".cline" / "skills",
    "kilo": HOME / ".config" / "kilo" / "skills",
}
KIMI_CONFIG = HOME / ".kimi-code" / "config.toml"
OPENCODE_CONFIG = HOME / ".config" / "opencode" / "opencode.json"
# Kilo is an OpenCode fork -- same CLI surface, same discovery rules, and its
# own log line still says `opencode`. Its embedded documentation gives the
# paths verbatim: skills at `{skill,skills}/<name>/SKILL.md` inside any config
# directory, instructions from the `instructions` config field. So it takes the
# OpenCode route, not the agents.md one cline needed.
#
# The config file has several accepted names and the installed one wins; a
# second file created beside it would be a config the host may never read.
KILO_DIR = HOME / ".config" / "kilo"
KILO_CONFIG_NAMES = ("kilo.json", "kilo.jsonc", "opencode.json", "opencode.jsonc")
PREFIX = "prime-"

# Skills reference core by number (PRINCIPLES §3, GUARDRAILS G8). Linking
# skills/ alone leaves every one of those references pointing at a file no host
# ever loads. Each host has one file it always reads; a managed block there
# makes core reachable. Markers keep uninstall exact.
BEGIN, END = "<!-- primeskills:begin -->", "<!-- primeskills:end -->"
CORE_FILES = ("PRINCIPLES.md", "GUARDRAILS.md", "OUTPUT.md")
# Read-only agent profiles. Paths and frontmatter come from each project's own
# documentation; four guesses beforehand all failed, and the docs took a minute.
PROFILES = {
    "opencode": (HOME / ".config" / "opencode" / "agents" / "prime-analyst.md",
                 ROOT / "adapters" / "opencode" / "prime-analyst.md"),
    "kimi": (HOME / ".kimi-code" / "agents" / "prime-analyst.md",
             ROOT / "adapters" / "kimi" / "prime-analyst.md"),
    # Kilo scans `{agent,agents}/**/*.md`; `agent/` matches its own singular
    # convention for `command/`, and the frontmatter is OpenCode's.
    "kilo": (HOME / ".config" / "kilo" / "agent" / "prime-analyst.md",
             ROOT / "adapters" / "kilo" / "prime-analyst.md"),
}
ALWAYS_LOADED = {
    "claude": HOME / ".claude" / "CLAUDE.md",
    "codex": HOME / ".codex" / "AGENTS.md",
    "kimi": HOME / ".kimi-code" / "AGENTS.md",
    # Cline reads the cross-tool agents.md standard from ~/.agents (its docs
    # list it beside the native rules). The file is shared with every other
    # tool that speaks the standard, so the managed markers do the exactness
    # work uninstall relies on everywhere else.
    "cline": HOME / ".agents" / "AGENTS.md",
}


def rule_span():
    """The highest P and G numbers, read from `core/` rather than typed.

    The line below said G1-G8 while G10 was already in the file and already
    installed in four agents' always-loaded configuration -- the one place
    where a stale number is read by every session before anything else.
    """
    def top(name, prefix):
        text = (ROOT / "core" / name).read_text(encoding="utf-8")
        found = [int(n) for n in re.findall(rf"\*\*{prefix}(\d+)", text)]
        return max(found) if found else 0
    return top("PRINCIPLES.md", "P") or 8, top("GUARDRAILS.md", "G")


def bootstrap_text():
    paths = "\n".join(f"- {ROOT / 'core' / f}" for f in CORE_FILES)
    principles, guardrails = rule_span()
    return f"""{BEGIN}
## primeskills

Before the first primeskills skill runs in a session, read these three files
once. The skills reference them by number (PRINCIPLES §1-§{principles},
GUARDRAILS G1-G{guardrails}) and are incomplete without them.

{paths}
{END}"""


def markers_sane(text):
    """One opening marker, one closing, in that order — or we do not touch it.

    A half-deleted block leaves a stray marker, and rewriting around it either
    duplicates the pointer or swallows the user's own text.
    """
    b, e = text.count(BEGIN), text.count(END)
    if b == e == 0:
        return True
    if b != 1 or e != 1:
        return False
    return text.index(BEGIN) < text.index(END)


def strip_block(text):
    if BEGIN not in text:
        return text, False
    head, rest = text.split(BEGIN, 1)
    tail = rest.split(END, 1)[1] if END in rest else ""
    return (head.rstrip() + "\n" + tail.lstrip()).strip() + "\n", True


def profile(agent, apply_it, remove):
    """Link the read-only profile where the host looks for it.

    Never unlink a file we did not create: another tool may own a profile of the
    same name, and an installer that deletes it is worse than one that fails.
    """
    if agent not in PROFILES:
        return None
    dest, src = PROFILES[agent]
    exists = dest.is_symlink() or dest.exists()
    ours = dest.is_symlink() and os.path.realpath(dest) == str(src)
    if exists and not ours:
        return f"prime-analyst: {dest} exists and is not ours, left alone"
    if not apply_it:
        return ("prime-analyst would be removed" if remove else
                f"prime-analyst would be linked into {dest.parent.name}/")
    dest.parent.mkdir(parents=True, exist_ok=True)
    if exists:
        dest.unlink()
    if not remove:
        dest.symlink_to(src)
    return ("prime-analyst removed" if remove else
            f"prime-analyst linked into {dest.parent.name}/")


def kilo_config():
    """The config file kilo actually reads here, or where to create one.

    Returns the first accepted name that exists; with none present, the
    canonical `kilo.json`. Writing to the canonical name while `kilo.jsonc`
    sits beside it would put core in a file the host loads second, or not at
    all.
    """
    for name in KILO_CONFIG_NAMES:
        candidate = KILO_DIR / name
        if candidate.is_file():
            return candidate
    return KILO_DIR / KILO_CONFIG_NAMES[0]


def instructions_config(agent):
    """The JSON config whose `instructions` list carries core, or None."""
    if agent == "opencode":
        return OPENCODE_CONFIG
    if agent == "kilo":
        return kilo_config()
    return None


def bootstrap(agent, apply_it, remove):
    """Returns a one-line status."""
    config = instructions_config(agent)
    if config is not None:
        if not config.is_file():
            return "no config, skipped"
        import json
        try:
            data = json.loads(config.read_text(encoding="utf-8"))
        except ValueError:
            # A .jsonc may legitimately carry comments, and rewriting it as
            # plain JSON would delete the user's own notes. Say so and stop:
            # a config we cannot read back is a config we must not write.
            return (f"{config.name} is not valid JSON — left alone, "
                    f"add core to `instructions` by hand")
        instructions = data.get("instructions", [])
        want = [str(ROOT / "core" / f) for f in CORE_FILES]
        present = all(w in instructions for w in want)
        if not apply_it:
            return ("core already in instructions" if present and not remove
                    else "core would be removed from instructions" if remove
                    else "core would be added to instructions")
        instructions = [i for i in instructions if i not in want]
        if not remove:
            instructions += want
        data["instructions"] = instructions
        backup_once(config)
        write_atomic(config, json.dumps(data, indent=2) + "\n",
                     check=json.loads)
        return ("core already in instructions" if present and not remove
                else "core removed from instructions" if remove
                else "core added to instructions")

    target = ALWAYS_LOADED.get(agent)
    if target is None:
        return "no always-loaded file known"
    text = target.read_text(encoding="utf-8") if target.is_file() else ""
    if not markers_sane(text):
        return (f"{target.name}: primeskills markers are damaged "
                f"({text.count(BEGIN)} begin, {text.count(END)} end) — fix by hand, left alone")
    cleaned, had = strip_block(text)
    if not apply_it:
        return (f"core pointer would be removed from {target.name}" if remove
                else f"core pointer would be "
                     f"{'refreshed in' if had else 'added to'} {target.name}")
    target.parent.mkdir(parents=True, exist_ok=True)
    backup_once(target)
    write_atomic(target,
                 cleaned if remove else (cleaned.rstrip() + "\n\n" + bootstrap_text() + "\n"))
    return (f"core pointer removed from {target.name}" if remove
            else f"core pointer {'refreshed in' if had else 'added to'} {target.name}")


# Skills call `primeskills-run` by name. A skill that names a command the host
# cannot resolve is an instruction that fails silently, so the command gets a
# place on PATH here rather than an absolute path baked into every SKILL.md.
CLAUDE_SETTINGS = HOME / ".claude" / "settings.json"
# The guard hooks used to be declared in fence's own frontmatter, so nothing was
# intercepted until someone invoked the skill: a destructive command on step two
# of a session that reached `/fence` on step twenty went through untouched, while
# G9 promised the opposite. Installing them puts the guard up with the set. The
# command names this repository's absolute path, which also removes the older
# defect of pointing at ~/.claude/skills/fence/ when a collision had renamed the
# skill to prime-fence.
HOOKS = [("Bash", "check-commands.py", "fence: checking the command"),
         ("Edit|Write|NotebookEdit", "check-boundary.py", "fence: checking the boundary")]
MANIFEST = HOME / ".primeskills" / "installed.json"
LOCAL_BIN = HOME / ".local" / "bin"
# Every tool a skill names by bare name belongs here: `handon` called
# `primeskills-handoffs` and Codex answered 127, command not found
# (2026-08-21). A skill that names a command the shell cannot find is an
# instruction that fails silently.
SHARED_TOOLS = ("primeskills-run", "primeskills-help", "primeskills-handoffs")


def hook_command(script):
    """Quoted: the host runs this through a shell, and a space or a shell
    metacharacter in the installation path would break it or worse."""
    return "python3 " + shlex.quote(str(ROOT / "skills" / "fence" / "bin" / script))


def is_our_hook(entry):
    """Ours if it runs a fence script from any tree of this set.

    Testing against ROOT alone read the same installation two ways depending on
    which copy was running: `--unpin` runs from the working copy, saw the
    pinned tree's hooks as a stranger's, kept them and appended its own. The
    result was four hooks in `settings.json`, two of them from a different
    version of the guard, and the host ran both (PS-048). Both roots are ours,
    and containment is still the test.
    """
    roots = [str(ROOT), str(PINNED)]
    for h in entry.get("hooks", []):
        cmd = str(h.get("command", ""))
        if "/skills/fence/bin/" in cmd and any(r in cmd for r in roots):
            return True
    return False


def hooks(apply_it, remove):
    """Arm the guards at install time. One line of status back."""
    if not CLAUDE_SETTINGS.parent.is_dir():
        return "Claude Code not installed here, skipped"
    data = {}
    if CLAUDE_SETTINGS.is_file():
        try:
            data = json.loads(CLAUDE_SETTINGS.read_text(encoding="utf-8"))
        except ValueError:
            return f"{CLAUDE_SETTINGS.name} is not valid JSON — left alone, fix by hand"
    pre = (data.get("hooks") or {}).get("PreToolUse") or []
    kept = [e for e in pre if not is_our_hook(e)]
    wanted = [{"matcher": matcher,
               "hooks": [{"type": "command", "command": hook_command(script),
                          "statusMessage": message}]}
              for matcher, script, message in HOOKS]
    already = len(kept) != len(pre)
    if not apply_it:
        return ("hooks already armed" if already and not remove
                else "hooks would be removed" if remove
                else "hooks would be armed in settings.json")
    data.setdefault("hooks", {})["PreToolUse"] = kept if remove else kept + wanted
    if not data["hooks"]["PreToolUse"]:
        data["hooks"].pop("PreToolUse")
    if not data["hooks"]:
        data.pop("hooks")
    backup_once(CLAUDE_SETTINGS)
    write_atomic(CLAUDE_SETTINGS, json.dumps(data, indent=2, ensure_ascii=False) + "\n",
                 check=json.loads)
    return ("hooks removed from settings.json" if remove
            else f"hooks armed in settings.json ({len(wanted)} matchers)")


def command(apply_it, remove):
    done, skipped = [], []
    for name in SHARED_TOOLS:
        src = ROOT / "bin" / name
        dest = LOCAL_BIN / name
        ours_link = dest.is_symlink() and os.path.realpath(dest) == str(src)
        if remove:
            if apply_it and ours_link:
                dest.unlink()
            (done if ours_link else skipped).append(name)
            continue
        if dest.exists() and not ours_link:
            skipped.append(name)
            continue
        if apply_it:
            LOCAL_BIN.mkdir(parents=True, exist_ok=True)
            if dest.is_symlink():
                dest.unlink()
            dest.symlink_to(src)
        done.append(name)
    on_path = str(LOCAL_BIN) in os.environ.get("PATH", "").split(os.pathsep)
    tail = "" if on_path else f" (warning: {LOCAL_BIN} is not on PATH)"
    verb = ("unlinked" if apply_it else "would unlink") if remove else \
           ("linked" if apply_it else "would link")
    note = f"; left alone: {', '.join(skipped)}" if skipped else ""
    return f"{', '.join(done) or 'nothing'} {verb} into {LOCAL_BIN}{tail}{note}"


def manifest_read():
    """What this installer created, and where each entry pointed.

    `is_ours` guesses from a symlink target; that guess is wrong for a directory
    a previous version left behind, and it cannot tell our link from an
    identical one made by hand. The manifest is a record, and uninstall removes
    only what is recorded and still points where it was recorded to point.
    """
    if not MANIFEST.is_file():
        return {}
    try:
        return json.loads(MANIFEST.read_text(encoding="utf-8"))
    except ValueError:
        return {}


def manifest_write(entries):
    MANIFEST.parent.mkdir(parents=True, exist_ok=True)
    write_atomic(MANIFEST, json.dumps(entries, indent=2, ensure_ascii=False) + "\n",
                 check=json.loads)


def write_atomic(path, text, check=None):
    """Temp file, parse it back, then one rename.

    A half-written CLAUDE.md or opencode.json is worse than an unmodified one,
    and a crash between truncate and write leaves exactly that.

    Three details are security, not tidiness. The temp name used to be
    predictable, so anyone able to write in that directory could pre-create it
    as a symlink and have us write through it; O_EXCL and O_NOFOLLOW refuse
    that, and a random suffix removes the guess. The mode used to come from the
    umask, so a config kept at 0600 came back 0644 with whatever token was
    inside it readable by the group; the original mode is carried over, and a
    new file starts at 0600. And fsync before the rename means a power cut
    leaves the old file, not an empty one.
    """
    if check is not None:
        check(text)
    tmp = path.with_name(f".{path.name}.primeskills-{os.urandom(6).hex()}")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
    fd = os.open(tmp, flags, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        if check is not None:
            check(tmp.read_text(encoding="utf-8"))
        if path.exists() and not path.is_symlink():
            os.chmod(tmp, path.stat().st_mode & 0o7777)
        os.replace(tmp, path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def backup_once(path):
    """One backup per file per run, kept next to the original."""
    if not path.is_file():
        return None
    dest = path.with_name(path.name + ".primeskills-backup")
    if not dest.exists():
        shutil.copy2(path, dest)
    return dest


def ours():
    return sorted(p.parent for p in SKILLS.glob("*/SKILL.md"))


def under_root(path):
    """Inside our repository or our pinned worktree, by path components rather
    than by substring.

    `str(ROOT) in realpath` matched any sibling whose name merely starts with
    ours -- a `primeskills-foreign` next door read as ours, and the caller of
    this function is allowed to `shutil.rmtree` what it owns. The pinned tree
    counts as ours too, or unpinning would refuse to remove links it installed.
    """
    try:
        real = Path(os.path.realpath(path))
        return any(real.is_relative_to(base) for base in (ROOT, PINNED))
    except (OSError, ValueError):
        return False


_RECORD = None


def recorded_src(dest):
    """What the manifest says this installer put at that path, if anything."""
    global _RECORD
    if _RECORD is None:
        _RECORD = manifest_read()
    return _RECORD.get(str(dest))


def is_ours(path):
    """A link we created, so uninstall never removes someone else's skill.

    Two questions, not one. `under_root` answers "does this lead into the tree I
    am running from", and that reads a single installation two ways depending on
    which copy is running. On 2026-08-21 `--apply` from the pinned worktree saw
    every directory installed live as a stranger's, took the prefixed name for
    all 27 of them, and left three agents offering each skill twice. PS-048
    fixed the same defect for hooks by naming both roots; a live checkout can
    sit anywhere, so skills need the record instead. Ours if it leads into a
    tree of ours **or** the manifest recorded it and it still points where it
    was recorded to point — the second half is a record, not a guess, and the
    "still points" is what keeps it from claiming a name someone else took
    since.
    """
    if path.is_symlink():
        src = recorded_src(path)
        return under_root(path) or (
            src is not None
            and os.path.realpath(path) == os.path.realpath(src))
    inner = path / "SKILL.md"
    if not inner.is_symlink():
        return False
    src = recorded_src(path)
    return under_root(inner) or (
        src is not None
        and os.path.realpath(inner) == os.path.realpath(Path(src) / "SKILL.md"))


def target_name(agent, skill_dir):
    """Prefix only on a real collision, so names stay plain where they can.

    Returns None when the prefixed name is taken as well: the first version
    checked one collision and then deleted whatever sat on the second.
    """
    plain = TARGETS[agent] / skill_dir.name
    if not (plain.exists() or plain.is_symlink()) or is_ours(plain):
        return skill_dir.name
    prefixed = TARGETS[agent] / (PREFIX + skill_dir.name)
    if not (prefixed.exists() or prefixed.is_symlink()) or is_ours(prefixed):
        return PREFIX + skill_dir.name
    return None


def plan_agent(agent):
    """The steps for one agent, plus the copies of ours left under the other name.

    `target_name` prefixes on a collision, and the collision can end: the
    foreign `autoplan` goes away, the plain name comes free, and the next
    install writes `autoplan` while `prime-autoplan` stays behind. Both then
    point into this repository, so the host offers one skill twice and the
    doctor's count reads full while a skill is missing. Ours to clean up,
    because we are the ones who put it there.
    """
    root = TARGETS[agent]
    steps = []
    for skill in ours():
        name = target_name(agent, skill)
        if name is None:
            steps.append(("blocked", root / skill.name, skill))
            continue
        dest = root / name
        other = root / (skill.name if name != skill.name else PREFIX + skill.name)
        if (other.exists() or other.is_symlink()) and is_ours(other):
            steps.append(("stale", other, skill))
        steps.append((("dir" if agent == "claude" else "link"), dest, skill))
    return steps


def apply_claude(dest, src):
    if (dest.exists() or dest.is_symlink()) and not is_ours(dest):
        return False
    if dest.is_symlink() or dest.is_file():
        dest.unlink()
    dest.mkdir(parents=True, exist_ok=True)
    for item in src.rglob("*"):
        if item.is_dir():
            continue
        rel = item.relative_to(src)
        out = dest / rel
        out.parent.mkdir(parents=True, exist_ok=True)
        if out.is_symlink() or out.exists():
            out.unlink()
        out.symlink_to(item)
    return True


def remove_ours(dest):
    """Take back what we put there and nothing else.

    Uninstall used to `shutil.rmtree` a directory the manifest called ours. The
    directory is ours; the files someone added inside it afterwards are not, and
    they went with it. Now the links pointing into this repository are removed,
    the directory goes only if it empties, and whatever is left is reported by
    name rather than deleted.
    """
    if dest.is_symlink() or dest.is_file():
        dest.unlink()
        return 0
    if not dest.is_dir():
        return 0
    for item in sorted(dest.rglob("*"), key=lambda p: len(p.parts), reverse=True):
        if item.is_symlink() and under_root(item):
            item.unlink()
        elif item.is_dir() and not any(item.iterdir()):
            item.rmdir()
    left = list(dest.iterdir())
    if not left:
        dest.rmdir()
        return 0
    return len(left)


def apply_link(dest, src):
    """Replace our own link, never someone else's directory.

    `target_name` prefixes on a first collision but not a second, so without
    this check a `prime-<name>` belonging to another tool would be removed by
    `shutil.rmtree`. Refusing is the only safe answer: the caller reports it.
    """
    if dest.exists() or dest.is_symlink():
        if not is_ours(dest):
            return False
        if dest.is_symlink() or dest.is_file():
            dest.unlink()
        elif remove_ours(dest):
            # Uninstall stopped doing this on 2026-08-18 and the update path
            # kept doing it: a directory of ours holding a file of theirs went
            # through rmtree on the next install. Take back only our links.
            return False
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.symlink_to(src, target_is_directory=True)
    return True


def kimi_state():
    if not KIMI_CONFIG.is_file():
        return None
    data = tomllib.loads(KIMI_CONFIG.read_text(encoding="utf-8"))
    return data.get("extra_skill_dirs", [])


def kimi_apply(add):
    text = KIMI_CONFIG.read_text(encoding="utf-8")
    dirs = kimi_state() or []
    want = str(SKILLS)
    if add and want not in dirs:
        dirs.append(want)
    if not add and want in dirs:
        dirs.remove(want)
    rendered = "extra_skill_dirs = [" + ", ".join(f'"{d}"' for d in dirs) + "]"
    if "extra_skill_dirs" in text:
        out = []
        for line in text.splitlines():
            out.append(rendered if line.strip().startswith("extra_skill_dirs") else line)
        text = "\n".join(out) + "\n"
    else:
        text += "\n" + rendered + "\n"
    backup_once(KIMI_CONFIG)
    write_atomic(KIMI_CONFIG, text, check=tomllib.loads if isinstance(text, str) else None)


def git(*args):
    return subprocess.run(("git",) + args, capture_output=True, text=True)


def pin_state():
    if not PIN_FILE.is_file():
        return None
    try:
        return json.loads(PIN_FILE.read_text(encoding="utf-8"))
    except ValueError:
        return None


def pinned_is_dirty():
    """Uncommitted work inside the pinned worktree. `worktree remove --force`
    would throw it away without a word, and it is still someone's work."""
    if not PINNED.is_dir():
        return False
    out = git("-C", str(PINNED), "status", "--porcelain")
    return bool(out.stdout.strip())


def pin(ref, agents, force=False):
    """Point the agents at a fixed commit, and let that commit install itself.

    Ordered so that a failure leaves the previous state: the worktree is built
    first, the installation runs from it, and only a successful installation
    writes the pin. The first version wrote the pin before installing, so a
    failed install left the agents following a tree the record said they were
    not following.
    """
    sha = git("-C", str(ROOT), "rev-parse", ref).stdout.strip()
    if not sha:
        sys.exit(f"primeskills-install: {ref!r} is not a commit in {ROOT}")
    if pinned_is_dirty() and not force:
        sys.exit(f"primeskills-install: {PINNED} has uncommitted work. Commit it, "
                 f"move it, or repeat with --force to discard it.")
    previous = PIN_FILE.read_text(encoding="utf-8") if PIN_FILE.is_file() else None
    was = (pin_state() or {}).get("commit")
    PINNED.parent.mkdir(parents=True, exist_ok=True)
    # Build the new tree beside the old one, not in its place. The old tree used
    # to be removed first, so a `worktree add` that failed -- a bad commit, a
    # full disk -- left four agents pointing at a directory that no longer
    # existed. Nothing is taken away until the replacement is on disk.
    staging = PINNED.with_name(PINNED.name + ".incoming")
    if staging.exists():
        git("-C", str(ROOT), "worktree", "remove", "--force", str(staging))
    made = git("-C", str(ROOT), "worktree", "add", "--detach", str(staging), sha)
    if made.returncode != 0:
        sys.exit(f"primeskills-install: worktree failed — {made.stderr.strip()}. "
                 f"The pinned tree in use was left alone.")
    if PINNED.exists():
        git("-C", str(ROOT), "worktree", "remove", "--force", str(PINNED))
    moved = git("-C", str(ROOT), "worktree", "move", str(staging), str(PINNED))
    if moved.returncode != 0:
        # Put back what was there, so the agents' paths keep resolving.
        if was:
            git("-C", str(ROOT), "worktree", "add", "--detach", str(PINNED), was)
        git("-C", str(ROOT), "worktree", "remove", "--force", str(staging))
        sys.exit(f"primeskills-install: не удалось поставить новое дерево на "
                 f"место — {moved.stderr.strip()}. Прежнее возвращено.")
    # --live on the inner call: the pinned tree installs itself from itself,
    # and without the flag it would try to pin again, forever.
    out = subprocess.run([sys.executable, str(PINNED / "bin" / "primeskills-install"),
                          *agents, "--apply", "--live"], text=True)
    if out.returncode != 0:
        git("-C", str(ROOT), "worktree", "remove", "--force", str(PINNED))
        if previous is not None:
            write_atomic(PIN_FILE, previous, check=json.loads)
        sys.exit("primeskills-install: установка из закреплённого дерева не удалась, "
                 "пин не записан, прежнее состояние возвращено")
    write_atomic(PIN_FILE, json.dumps({"ref": ref, "commit": sha}, indent=2) + "\n",
                 check=json.loads)
    print(f"pinned: {ref} = {sha[:8]} at {PINNED}")
    return 0


def unpin(agents, force=False):
    """Return the agents to the working copy, and only then let go of the pin.

    Ordered the other way round at first: the record was deleted, the reinstall
    attempted, and the worktree removed whatever happened — a failed reinstall
    left dangling links and took any uncommitted work in the pinned tree with
    it.
    """
    if not PIN_FILE.is_file():
        print("not pinned")
        return 0
    if pinned_is_dirty() and not force:
        sys.exit(f"primeskills-install: {PINNED} has uncommitted work. Commit it, "
                 f"move it, or repeat with --force to discard it.")
    code = subprocess.run([sys.executable, str(Path(__file__).resolve()),
                           *agents, "--apply", "--live"], text=True).returncode
    if code != 0:
        sys.exit("primeskills-install: возврат на рабочую копию не удался, "
                 "пин оставлен как был")
    # The inner `--live` install removes the record itself — it has to, the
    # links it just wrote point at the working copy. Unlinking again raised
    # FileNotFoundError *after* "unpinned" was printed, and the traceback took
    # the worktree removal below with it (PS-048).
    PIN_FILE.unlink(missing_ok=True)
    git("-C", str(ROOT), "worktree", "remove", "--force", str(PINNED))
    print(f"unpinned: agents follow the working copy at {ROOT}")
    return 0


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("agents", nargs="*", default=[],
                    help="claude codex opencode kimi cline kilo; empty = all")
    ap.add_argument("--apply", action="store_true", help="do it (default: print the plan)")
    ap.add_argument("--uninstall", action="store_true")
    ap.add_argument("--pin", metavar="COMMIT",
                    help="install from a worktree fixed at this commit")
    ap.add_argument("--unpin", action="store_true",
                    help="go back to installing from the working copy")
    ap.add_argument("--force", action="store_true",
                    help="with --pin/--unpin: discard uncommitted work in the pinned tree")
    ap.add_argument("--live", action="store_true",
                    help="install from the working copy instead of a pinned commit")
    args = ap.parse_args()

    if args.pin:
        return pin(args.pin, args.agents, args.force)
    if args.unpin:
        return unpin(args.agents, args.force)
    # Pinned by default. An installation that follows a working copy is a
    # supply chain the length of one editor: every save reaches four agents and
    # the hooks they run, in sessions already in flight. Development wants that
    # and says so with --live; everyone else gets a fixed commit.
    if (args.apply and not args.live and ROOT != PINNED
            and not PIN_FILE.is_file()):
        if git("-C", str(ROOT), "rev-parse", "--git-dir").returncode == 0:
            print("устанавливаю с закреплённого коммита (--live ставит с рабочей копии)")
            return pin("HEAD", args.agents, args.force)
        print("не git-репозиторий: ставлю с рабочей копии, закрепить нечего")
    state = pin_state()
    if state and Path(__file__).resolve().parent.parent != PINNED:
        print(f"note: agents are pinned to {state['commit'][:8]}; this command "
              f"installs from {ROOT}. Use --pin/--unpin to move the pin.")

    agents = args.agents or list(TARGETS) + ["kimi"]
    verb = ("remove" if args.apply else "would remove") if args.uninstall else \
           ("link" if args.apply else "would link")
    recorded = manifest_read()
    created = {}

    print(f"shared: {command(args.apply, args.uninstall)}")
    if "claude" in agents:
        print(f"claude: {hooks(args.apply, args.uninstall)}")

    for agent in agents:
        if agent == "kimi":
            dirs = kimi_state()
            if dirs is None:
                print("kimi: no config.toml, skipped")
                continue
            present = str(SKILLS) in dirs
            action = "already listed" if present and not args.uninstall else \
                     ("not listed" if not present and args.uninstall else f"{verb} extra_skill_dirs entry")
            print(f"kimi: {action}")
            if args.apply:
                kimi_apply(not args.uninstall)
            print(f"kimi: {bootstrap('kimi', args.apply, args.uninstall)}")
            print(f"kimi: {profile('kimi', args.apply, args.uninstall)}")
            continue

        if agent not in TARGETS:
            print(f"unknown agent {agent}", file=sys.stderr)
            return 2
        root = TARGETS[agent]
        if not root.parent.exists():
            print(f"{agent}: not installed here, skipped")
            continue
        renamed, refused, cleaned = [], [], []
        steps = plan_agent(agent)
        for kind, dest, src in steps:
            if kind == "blocked":
                refused.append(f"{src.name} (both names taken)")
                continue
            if kind == "stale":
                cleaned.append(dest.name)
                if args.apply:
                    root.mkdir(parents=True, exist_ok=True)
                    if remove_ours(dest):
                        refused.append(f"{dest.name} (kept: files not ours)")
                    recorded.pop(str(dest), None)
                    created.pop(str(dest), None)
                continue
            if dest.name != src.name:
                renamed.append(f"{src.name} -> {dest.name}")
            if not args.apply:
                continue
            if args.uninstall:
                want = recorded.get(str(dest))
                if want is None:
                    continue  # not ours by the record; leave it alone
                if not (dest.exists() or dest.is_symlink()):
                    recorded.pop(str(dest), None)
                    continue
                if os.path.realpath(dest) != want and not is_ours(dest):
                    refused.append(f"{dest.name} (points elsewhere now)")
                    continue
                leftover = remove_ours(dest)
                if leftover:
                    refused.append(f"{dest.name} (kept: {leftover} file(s) not ours)")
                recorded.pop(str(dest), None)
                continue
            root.mkdir(parents=True, exist_ok=True)
            if kind == "blocked":
                continue
            if not (apply_claude if kind == "dir" else apply_link)(dest, src):
                refused.append(dest.name)
            else:
                created[str(dest)] = str(src)
        note = f"  (renamed on collision: {', '.join(renamed)})" if renamed else ""
        if cleaned:
            note += ("  (stale copy removed: " if args.apply else
                     "  (stale copy to remove: ") + ", ".join(sorted(cleaned)) + ")"
        if refused:
            note += f"  (LEFT ALONE, not ours: {', '.join(sorted(refused))})"
        count = len([s for s in steps if s[0] != "stale"])
        print(f"{agent}: {verb} {count} skills in {root}{note}")
        print(f"{agent}: {bootstrap(agent, args.apply, args.uninstall)}")
        note = profile(agent, args.apply, args.uninstall)
        if note:
            print(f"{agent}: {note}")

    if args.apply:
        if args.uninstall:
            manifest_write(recorded)
        else:
            # A skill dropped from the set leaves its link behind otherwise, and
            # a link nobody maintains is a stale instruction that still loads.
            ours = {p.parent.name for p in SKILLS.glob("*/SKILL.md")}
            stale = [dest for dest, src in recorded.items()
                     if Path(src).name not in ours and Path(dest).exists()]
            for dest in stale:
                if is_ours(Path(dest)):
                    remove_ours(Path(dest))
                    recorded.pop(dest, None)
            if stale:
                print(f"снято устаревших: {len(stale)} "
                      f"({', '.join(Path(d).name for d in stale)})")
            recorded.update(created)
            manifest_write(recorded)
        if args.live and PIN_FILE.is_file():
            # The links now point at the working copy, so a pin record left
            # behind would describe an installation that no longer exists.
            PIN_FILE.unlink()
            print(f"пин снят: агенты читают {ROOT}")
    else:
        print("\nnothing changed. Re-run with --apply.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
