#!/usr/bin/env python3
"""Format linter for primeskills SKILL.md files.

Checks the contract from docs/SKILL-FORMAT.md. Exit 0 = clean, 1 = violations.
Rule IDs (F1..F9) are stable so tests can assert on them.
"""
import re
import sys
from pathlib import Path

import yaml

SECTIONS = ["Trigger", "Invariants", "Procedure", "Stop conditions", "Output", "References"]
ROLES = {"read-only", "write"}
WRITING_TOOLS = {"Edit", "Write", "NotebookEdit"}
DESC_MAX = 140
DEFAULT_BUDGET = 800
REF_BUDGET = 700             # one reference file
REF_TOTAL_BUDGET = 1200      # all references of one skill
PARAPHRASE = 0.34            # share of a core rule's words an invariant may echo
CORE_BUDGET = 1760          # always-loaded files; a ceiling, not a target
# What one skill call actually costs: core, every description, the pointer the
# installer writes, and the body. This is the number that matters -- C1 and F4
# are guards underneath it. Raising core spends skill headroom and vice versa,
# and the arithmetic is meant to be visible when either moves.
CALL_BUDGET = 3000
CORE_ALWAYS = ("PRINCIPLES.md", "GUARDRAILS.md", "OUTPUT.md")


def split_frontmatter(text):
    if not text.startswith("---\n"):
        return None, text
    end = text.find("\n---\n", 4)
    if end == -1:
        return None, text
    try:
        return yaml.safe_load(text[4:end]), text[end + 5:]
    except yaml.YAMLError:
        return None, text[end + 5:]


def sections_of(body):
    """Return [(heading, content)] for level-2 headings, in file order."""
    out, name, buf = [], None, []
    for line in body.splitlines():
        if line.startswith("## "):
            if name is not None:
                out.append((name, "\n".join(buf)))
            name, buf = line[3:].strip(), []
        elif name is not None:
            buf.append(line)
    if name is not None:
        out.append((name, "\n".join(buf)))
    return out


def steps_of(procedure):
    """Split a procedure body into numbered steps (a step may span lines)."""
    steps, buf = [], None
    for line in procedure.splitlines():
        if re.match(r"^\s*\d+\.\s", line):
            if buf is not None:
                steps.append("\n".join(buf))
            buf = [line]
        elif buf is not None:
            buf.append(line)
    if buf is not None:
        steps.append("\n".join(buf))
    return steps


def core_rules(core_dir):
    """Canonical rules with their ids, so a skill can cite instead of restate.

    F8 only catches copied lines. The commoner failure is a paraphrase: the
    same rule reworded, which drifts from the original and then contradicts it.
    """
    rules = {}
    g = (core_dir / "GUARDRAILS.md")
    if g.is_file():
        for m in re.finditer(r"\*\*(G\d+)[^*]*\*\*(.+?)(?=\n- \*\*|\n## |\Z)",
                             g.read_text(encoding="utf-8"), re.S):
            rules[m.group(1)] = m.group(2)
    pr = (core_dir / "PRINCIPLES.md")
    if pr.is_file():
        for m in re.finditer(r"^## (\d+)\. (.+?)\n(.*?)(?=\n## |\Z)",
                             pr.read_text(encoding="utf-8"), re.S | re.M):
            rules["P" + m.group(1)] = m.group(2) + " " + m.group(3)
    return {k: significant(v) for k, v in rules.items()}


STOPWORDS = {
    "the", "a", "an", "and", "or", "not", "is", "are", "was", "be", "to", "of",
    "in", "on", "it", "that", "this", "for", "with", "you", "your", "as", "at",
    "by", "from", "but", "if", "no", "any", "all", "one", "own", "than", "then",
    "what", "when", "which", "who", "does", "do", "did", "can", "will", "would",
}


def significant(text):
    words = re.findall(r"[a-z][a-z0-9-]{2,}", text.lower())
    return {w for w in words if w not in STOPWORDS}


def list_items(section):
    """Whole bullets, continuation lines folded in."""
    items, buf = [], None
    for line in section.splitlines():
        if line.strip().startswith("- "):
            if buf:
                items.append(" ".join(buf))
            buf = [line.strip()[2:]]
        elif buf is not None and line.startswith(("  ", "\t")) and line.strip():
            buf.append(line.strip())
        elif buf:
            items.append(" ".join(buf))
            buf = None
    if buf:
        items.append(" ".join(buf))
    return items


def normalize(line):
    line = re.sub(r"[`*_]", "", line.strip().lstrip("-").strip())
    return re.sub(r"\s+", " ", line.lower()).rstrip(".")


def check_skill(path, seen_invariants, problems, rules=None, known=()):
    def bad(rule, msg):
        problems.append((path, rule, msg))

    text = path.read_text(encoding="utf-8")
    meta, body = split_frontmatter(text)

    if not isinstance(meta, dict):
        bad("F1", "no valid YAML frontmatter")
        return
    for key in ("name", "description", "role"):
        if not meta.get(key):
            bad("F1", f"frontmatter missing '{key}'")
    if meta.get("name") and meta["name"] != path.parent.name:
        bad("F2", f"name '{meta['name']}' != directory '{path.parent.name}'")
    if meta.get("role") and meta["role"] not in ROLES:
        bad("F9", f"role '{meta['role']}' not in {sorted(ROLES)}")

    # F13: a flow's cost is the sum of what it calls, so the list has to resolve.
    # A name that no longer exists makes the weight wrong and the step unrunnable.
    # `calls` is the chain a flow always runs; `calls_optional` is the links it
    # takes only under a condition. They are split because counting a
    # conditional link as certain overstated every flow's weight.
    calls = meta.get("calls") or []
    optional = meta.get("calls_optional") or []
    if (calls or optional) and meta.get("tier") != "flow":
        bad("F13", "calls declared on a skill that is not tier: flow")
    for name in list(calls) + list(optional):
        if known and name not in known:
            bad("F13", f"calls unknown skill '{name}'")
    for name in optional:
        if name in calls:
            bad("F13", f"'{name}' is in both calls and calls_optional")
    if meta.get("tier") == "flow" and not calls:
        bad("F13", "tier: flow without a calls list")

    # F10: role and allowed-tools must agree. Claude Code enforces the latter;
    # everywhere else the role is the only statement, so they cannot drift.
    tools = meta.get("allowed-tools")
    if meta.get("role") == "read-only":
        if not tools:
            bad("F10", "read-only skill without allowed-tools")
        elif WRITING_TOOLS & set(tools):
            bad("F10", f"read-only skill allows {sorted(WRITING_TOOLS & set(tools))}")
    elif tools and not (WRITING_TOOLS & set(tools)):
        bad("F10", "write skill whose allowed-tools cannot write")

    desc = str(meta.get("description", ""))
    if len(desc) > DESC_MAX:
        bad("F3", f"description {len(desc)} chars > {DESC_MAX}")

    budget = meta.get("budget", DEFAULT_BUDGET)
    words = len(body.split())
    if words > budget:
        bad("F4", f"body {words} words > budget {budget}")

    found = [name for name, _ in sections_of(body)]
    if found != SECTIONS:
        bad("F5", f"sections {found} != {SECTIONS}")

    content = dict(sections_of(body))
    procedure = content.get("Procedure", "")
    steps = steps_of(procedure)
    if not steps:
        bad("F6", "Procedure has no numbered steps")
    for step in steps:
        if "verify:" not in step:
            bad("F6", f"step without 'verify:': {step.splitlines()[0].strip()[:60]}")

    for ref in meta.get("refs") or []:
        if not isinstance(ref, dict) or not ref.get("when"):
            bad("F7", f"ref without 'when': {ref}")

    for item in list_items(content.get("Invariants", "")):
        key = normalize(item)
        if not key:
            continue
        if key in seen_invariants:
            bad("F8", f"invariant copied verbatim from '{seen_invariants[key]}': {key[:60]}")
        else:
            seen_invariants[key] = path.parent.name

        terms = significant(item)
        for rid, rule_terms in (rules or {}).items():
            if rid in item or not rule_terms:
                continue          # already cited: that is the wanted shape
            shared = terms & rule_terms
            if len(shared) / len(rule_terms) >= PARAPHRASE:
                bad("F12", f"invariant restates {rid} without citing it "
                           f"(shared: {', '.join(sorted(shared)[:6])}): {key[:50]}")

    # F11: references are instructions too. Without a cap they become the place
    # excess text goes while F4 stays green.
    total = 0
    for ref in meta.get("refs") or []:
        if not isinstance(ref, dict) or not ref.get("path"):
            continue
        target = (path.parent / ref["path"]).resolve()
        if not target.is_file():
            bad("F11", f"ref path does not exist: {ref['path']}")
            continue
        n = len(target.read_text(encoding="utf-8").split())
        total += n
        if n > REF_BUDGET:
            bad("F11", f"{ref['path']} is {n} words > {REF_BUDGET}")
    if total > REF_TOTAL_BUDGET:
        bad("F11", f"references total {total} words > {REF_TOTAL_BUDGET}")


def pointer_words(root):
    """The block the installer writes into each host's always-loaded file."""
    try:
        import importlib.machinery
        import importlib.util
        loader = importlib.machinery.SourceFileLoader(
            "_pi", str(root / "bin" / "primeskills-install"))
        spec = importlib.util.spec_from_loader("_pi", loader)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return len(mod.bootstrap_text().split())
    except Exception:
        return 0


def check_call_cost(root, files, core_dir, problems):
    """C3: no single skill call costs more than CALL_BUDGET.

    Flows are excluded: they pay for a chain by design, and their cost is
    reported by primeskills-status rather than capped here.
    """
    core = sum(len((core_dir / n).read_text(encoding="utf-8").split())
               for n in CORE_ALWAYS if (core_dir / n).is_file())
    descs, worst, worst_name = 0, 0, None
    for path in files:
        meta, _ = split_frontmatter(path.read_text(encoding="utf-8"))
        if not isinstance(meta, dict):
            continue
        descs += len(str(meta.get("description", "")).split())
        if meta.get("tier") == "flow":
            continue
        budget = meta.get("budget", DEFAULT_BUDGET)
        if budget > worst:
            worst, worst_name = budget, meta.get("name")
    base = core + descs + pointer_words(root)
    total = base + worst
    if total > CALL_BUDGET:
        problems.append((core_dir, "C3",
                         f"худший вызов {total} слов > {CALL_BUDGET} "
                         f"(база {base} + бюджет '{worst_name}' {worst})"))


def check_core(core_dir, problems):
    """C1: the always-loaded part of core/ pays on every session. Cap it."""
    files = [core_dir / n for n in CORE_ALWAYS]
    missing = [f.name for f in files if not f.exists()]
    if missing:
        problems.append((core_dir, "C2", f"missing always-loaded files: {missing}"))
        return
    words = sum(len(f.read_text(encoding="utf-8").split()) for f in files)
    if words > CORE_BUDGET:
        problems.append((core_dir, "C1", f"core {words} words > budget {CORE_BUDGET}"))


def main(argv):
    root = Path(argv[1]) if len(argv) > 1 else Path(__file__).resolve().parent.parent / "skills"
    files = sorted(root.glob("*/SKILL.md"))
    core = root.parent / "core"
    if not files and not core.is_dir():
        print(f"nothing to lint under {root}", file=sys.stderr)
        return 1

    rules = core_rules(core) if core.is_dir() else {}
    known = {p.parent.name for p in files}
    seen, problems = {}, []
    for path in files:
        check_skill(path, seen, problems, rules, known)
    if core.is_dir():
        check_core(core, problems)
        check_call_cost(root.parent, files, core, problems)

    for path, rule, msg in problems:
        print(f"{path}: {rule}: {msg}")
    print(f"{len(files)} skills, {len(problems)} problems")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
