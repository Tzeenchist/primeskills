#!/usr/bin/env python3
"""Publish a GitHub release for the current version, with its changelog entry.

Written because nine tags were pushed and nine releases were not: the tags
carried a one-line subject and the repository's own account of what changed sat
in `CHANGELOG.md`, read by nobody. A release without notes is a version number
with no answer to "should I take it".

Refuses rather than guesses. `VERSION`, the top entry of `CHANGELOG.md` and the
tag must agree, the tag must point at the commit being released, and the entry
must have a body -- an empty release is the failure this program exists to
prevent. When skills or core changed since the last tag, every changed skill
must have a recorded live call from each of the six hosts (`livecall` notes in
the run record) -- PS-052: twice a skill was done until it was called from
where it lives. Prints the plan and changes nothing until `--apply`.
"""
import argparse
import hashlib
import json
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HOSTS = ("claude", "codex", "kimi", "opencode", "cline", "kilo")


def git(*args):
    return subprocess.run(("git", "-C", str(ROOT)) + args,
                          capture_output=True, text=True)


def entry(version):
    """The changelog section for this version, without its heading."""
    text = (ROOT / "CHANGELOG.md").read_text(encoding="utf-8")
    hit = re.search(rf"^## {re.escape(version)} — (\S+)$(.*?)(?=^## |\Z)",
                    text, flags=re.M | re.S)
    if not hit:
        sys.exit(f"primeskills-release: в CHANGELOG.md нет записи про {version}")
    date, body = hit.group(1), hit.group(2).strip()
    if not body:
        sys.exit(f"primeskills-release: запись про {version} пуста — "
                 f"релиз без описания не публикуется")
    return date, body


ITEM = re.compile(r"^\s*(?:[-*+]\s|\d+[.)]\s|#{1,6}\s|>\s)")


def unwrap(body):
    """Undo the file's own line wrapping, because GitHub does not.

    `CHANGELOG.md` is wrapped at the width the rest of the repository is
    wrapped at. A release body is rendered as GitHub Flavored Markdown with
    hard line breaks on, so every one of those newlines becomes a `<br>` and
    the entry arrives as a column of ragged short lines. The wrapping is right
    for the file and wrong for the page, so it is undone here rather than
    removed there. Blank lines, list boundaries and fenced code survive.
    """
    out, block, fenced = [], [], False
    def flush():
        if block:
            out.append(" ".join(line.strip() for line in block))
            block.clear()
    for line in body.splitlines():
        if line.lstrip().startswith("```"):
            flush()
            fenced = not fenced
            out.append(line)
            continue
        if fenced:
            out.append(line)
            continue
        if not line.strip():
            flush()
            out.append("")
            continue
        if ITEM.match(line):
            flush()
        block.append(line)
    flush()
    return "\n".join(out)


def notes_for(body, date):
    """The release body as it will be posted. Separate from `main` so that the
    unwrapping is tested where it is used, not only where it is defined: the
    first test called `unwrap` directly and stayed green when `main` stopped
    calling it."""
    return (f"{unwrap(body)}\n\n---\nВыпущено {date}. "
            f"Полный журнал изменений — `CHANGELOG.md`.")


def changed_since(at):
    """(skill names, core touched?) between the last tag and HEAD."""
    out = git("diff", "--name-only", f"{at}..HEAD").stdout.split()
    skills, core = set(), False
    for path in out:
        parts = Path(path).parts
        if parts and parts[0] == "skills" and len(parts) > 1:
            skills.add(parts[1])
        elif parts and parts[0] == "core":
            core = True
    return sorted(skills), core


def instant(text):
    """An ISO timestamp as a moment, or None if it will not parse.

    Ordering these as strings was wrong in a way that only showed once the
    gate had real work to do: `primeskills-run` records UTC and git records
    the committer's own offset, so 06:45+00:00 sorts before 09:21+03:00 while
    being 24 minutes later. A naive stamp is read as UTC, which is what the
    recorder writes.
    """
    try:
        moment = datetime.fromisoformat(text)
    except ValueError:
        return None
    return moment if moment.tzinfo else moment.replace(tzinfo=timezone.utc)


def missing_livecalls(at):
    """Changed skill × host pairs without a live-call note made since `at`.

    The note is `primeskills-run note livecall "<name>: what happened (<host>)"`
    recorded on the branch being released; its text must carry both the name
    and the host, because a verdict nobody can attribute to a host is the
    four-faces-of-one-defect again. Old notes do not count: the gate asks
    about this release's changes, so a call recorded for the previous tag
    must not satisfy this one.
    """
    tagged = instant(git("show", "-s", "--format=%cI", at).stdout.strip())
    skills, core_changed = changed_since(at)
    if not skills and not core_changed:
        return []
    names = set(skills) | ({"core"} if core_changed else set())
    # Each name is proved against its own change, not against the tag. Anchored
    # to the tag, a call made after it but before the change counted as proof of
    # the change -- which happened on 2026-08-25, when a checkpoint written
    # early in a session covered a pair while exercising the text as it stood
    # before two later fixes.
    since = {}
    for name_ in names:
        where = "core" if name_ == "core" else f"skills/{name_}"
        moved = git("log", "-1", "--format=%cI", f"{at}..HEAD", "--", where).stdout.strip()
        since[name_] = instant(moved) if moved else tagged
    plain = re.sub(r"[^a-zA-Z0-9._-]+", "-", "master").strip("-")
    record = (ROOT / ".primeskills" / "run" /
              f"{plain[:60]}-{hashlib.sha1(b'master').hexdigest()[:8]}.jsonl")
    have = set()
    if record.is_file():
        for line in record.read_text(encoding="utf-8").splitlines():
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                continue
            when = instant(str(e.get("ts", "")))
            if (e.get("kind") != "note" or e.get("stage") != "livecall"
                    or when is None):
                continue
            fresh = lambda k: since.get(k) is None or when >= since[k]
            # A note that addresses itself is believed and nothing else is
            # read from it. Falling back to the text keeps notes written before
            # the fields existed, but a fielded note must not also close pairs
            # it never claimed: that is the hole this closes.
            skill, host = e.get("skill"), e.get("host")
            if skill or host:
                if skill in names and host in HOSTS and fresh(skill):
                    have.add((skill, host))
                continue
            # Text is read only where it can answer. A note naming two hosts
            # cannot say which one it is about, and explaining a call in one
            # host by reference to another is the natural thing to write --
            # that is how a note about kilo closed claude's pair. One host
            # named, no ambiguity, still counts: the notes written before the
            # fields existed were not ambiguous.
            text = str(e.get("text", "")).lower()
            named = [h for h in HOSTS if h in text]
            if len(named) != 1:
                continue
            for n in names:
                if n.lower() in text and fresh(n):
                    have.add((n, named[0]))
    return sorted((n, h) for n in names for h in HOSTS if (n, h) not in have)


def main(argv):
    ap = argparse.ArgumentParser()
    ap.add_argument("version", nargs="?", help="по умолчанию — файл VERSION")
    ap.add_argument("--apply", action="store_true")
    ap.add_argument("--repo", default=None, help="по умолчанию — origin")
    args = ap.parse_args(argv)

    version = args.version or (ROOT / "VERSION").read_text(encoding="utf-8").strip()
    declared = (ROOT / "VERSION").read_text(encoding="utf-8").strip()
    if version != declared:
        sys.exit(f"primeskills-release: просят {version}, а VERSION говорит "
                 f"{declared}. Сперва согласуйте их.")
    tag = f"v{version}"
    date, body = entry(version)

    if git("rev-parse", "-q", "--verify", f"refs/tags/{tag}").returncode != 0:
        sys.exit(f"primeskills-release: тега {tag} нет. `git tag -a {tag}`.")
    at = git("rev-list", "-n", "1", tag).stdout.strip()
    head = git("rev-parse", "HEAD").stdout.strip()
    if at != head:
        print(f"внимание: {tag} стоит на {at[:8]}, а HEAD — {head[:8]}")
    if git("status", "--porcelain").stdout.strip():
        sys.exit("primeskills-release: дерево грязное — релиз описывает коммит, "
                 "а не рабочую копию")

    missing = missing_livecalls(at)
    if missing:
        lines = "\n".join(f"- {n}: нет живого вызова от {h}" for n, h in missing)
        sys.exit("primeskills-release: навыки/core менялись с прошлого тега, "
                 f"а живых вызовов не хватает:\n{lines}\n"
                 "Позовите навык в каждом хосте и запишите: "
                 'primeskills-run note livecall "<имя>: что показал вызов '
                 '(<host>)"')

    # A tag subject that only repeats the version says nothing the title
    # already carries, and it became the release title verbatim once.
    subject = git("tag", "-l", tag, "--format=%(contents:subject)").stdout.strip()
    if subject in (version, tag, ""):
        subject = ""
    title = subject or f"primeskills {version}"
    notes = notes_for(body, date)

    repo = ["--repo", args.repo] if args.repo else []
    exists = subprocess.run(["gh", "release", "view", tag, *repo],
                            capture_output=True, text=True, cwd=ROOT).returncode == 0
    if exists:
        print(f"{tag}: релиз уже есть — обновляю описание" if args.apply
              else f"{tag}: релиз уже есть, описание будет заменено")
        cmd = ["gh", "release", "edit", tag, "--title", title, "--notes", notes]
    else:
        cmd = ["gh", "release", "create", tag, "--verify-tag",
               "--title", title, "--notes", notes]

    if not args.apply:
        print(f"\n{title}\n{'-' * len(title)}\n{notes}\n")
        print("ничего не опубликовано. Повторите с --apply.")
        return 0
    done = subprocess.run(cmd + repo, capture_output=True, text=True, cwd=ROOT)
    if done.returncode != 0:
        sys.exit(f"primeskills-release: {done.stderr.strip()}")
    print(f"{tag}: {(done.stdout or '').strip() or 'опубликован'}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
