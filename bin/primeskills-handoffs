#!/usr/bin/env python3
"""List every checkpoint saved on this machine, newest first.

One checkpoint a tree: the file `.primeskills/handoff/checkpoint.md`, with a
`## <branch>` section per branch inside it. The file is the unit, so the row
is the file -- the reader opens it whole and finds their branch among the
sections themselves, instead of picking a branch blind from a menu. A branch
name still shows on the row (the current one marked), so "which of these is
mine" costs one glance, not a question. Files written under the older
one-per-branch scheme are rows too, so nothing already saved drops out.

Three sources, in this order: the trees named on the command line, the tree
the caller stands in, or the register of trees the set has worked in
(`~/.primeskills/trees.json`). The register exists because the first version
answered "not inside a git repository" and stopped -- and agents are started
from `$HOME`, where that is the normal case, not the edge one. Eight
checkpoints in seven trees were invisible from there (2026-08-21, reported by
OpenCode and Kimi). The filesystem is never scanned: what is listed is where
the set has already worked, or what the caller named.

It only prints, and it writes nothing -- not even the register, which
`primeskills-run` maintains. `handon` is a read-only skill (G16), and this is
the program it runs.
"""
import argparse
import json
import re
import subprocess
import sys
import time
from pathlib import Path

REGISTER = Path.home() / ".primeskills" / "trees.json"


def git(*args, cwd=None):
    done = subprocess.run(("git", *args), capture_output=True, text=True,
                          cwd=cwd)
    return done.returncode, done.stdout.strip()


def repo_top(cwd=None):
    code, top = git("rev-parse", "--show-toplevel", cwd=cwd)
    return Path(top) if code == 0 and top else None


def registered():
    """Trees the set has worked in, most recent first. Missing ones are dropped.

    A read of a record, not a search: `primeskills-run` writes an entry every
    time it resolves a repository, so a tree appears here once any skill has
    used the journal in it.
    """
    try:
        data = json.loads(REGISTER.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return [], 0
    seen = sorted(((str(when), path) for path, when in data.items()),
                  reverse=True)
    alive = [Path(p) for _, p in seen
             if (Path(p) / ".primeskills" / "handoff").is_dir()]
    return alive, len(seen) - len(alive)


def inside(path, top):
    """Is this a real file of this tree, reached without a symlink?

    The chosen file becomes the next agent's opening context, so where it comes
    from is part of what it proves. A link -- at the file or at any directory
    above it -- takes that context outside the tree the reader thinks they are
    in. Same reasoning as the run journal in `primeskills-run`, same answer.
    """
    if any(p.is_symlink() for p in (path, *path.parents)):
        return False
    try:
        path.resolve().relative_to(top.resolve())
    except ValueError:
        return False
    return True


def plural(n, one, few, many):
    """Russian agreement: the number is printed, so it is read."""
    if 11 <= n % 100 <= 14:
        return many
    return {1: one, 2: few, 3: few, 4: few}.get(n % 10, many)


def trees_of(n):
    return plural(n, "дереве", "деревьях", "деревьях")


def branch_alive(top, branch):
    return git("show-ref", "--verify", "--quiet",
               f"refs/heads/{branch}", cwd=top)[0] == 0


def sections_of(top, body, here_branch):
    """The `## <branch>` sections a checkpoint speaks for, marks included.

    The current branch of the tree we stand in is named as such, so the
    reader sees at a glance which section their session opens by itself;
    a section whose branch is gone keeps its text but says so.
    """
    heads = re.findall(r"^## +(\S.*?)\s*$", body, re.M)
    if not heads:
        return None
    marks = []
    for head in heads:
        mark = ""
        if here_branch and head == here_branch:
            mark = " ←текущая"
        elif not branch_alive(top, head):
            mark = " (сирота)"
        marks.append(head + mark)
    return marks


STAMP = re.compile(r"<!--\s*handoff:\s*([0-9T:+\-]{10,32})\s*-->")


def written_at(body):
    """When the newest section says it was written, or None.

    PS-068: the row used to be dated by `st_mtime`, which any touch moves --
    a `sed` over the file, a copy, this program's own reader on some systems.
    Caught on 2026-08-29 lying by three days in the fresher direction, which
    is the worse one: freshness is what the reader picks a tree by. `handoff`
    now stamps each section it writes, so the row can say when the record was
    made instead of when the file was last poked. Files written before the
    stamp existed have none, and those rows say which clock they are on rather
    than pretending.

    A trailing UTC offset is accepted and then ignored: the stamp is read as
    local time because a checkpoint never leaves the machine that wrote it
    (PS-022). Honouring the offset would only matter for a file that cannot
    get here.
    """
    best = None
    for hit in STAMP.findall(body):
        try:
            when = time.strptime(hit[:16], "%Y-%m-%dT%H:%M")
        except ValueError:
            continue
        stamped = time.mktime(when)
        if best is None or stamped > best:
            best = stamped
    return best


def rows_of(top, here_branch):
    """One row per checkpoint file of the tree, newest first.

    The file is what a reader opens, so the file is what gets a number.
    `checkpoint.md` shows its branch sections inline; a legacy file named for
    its branch shows that branch.
    """
    root = top / ".primeskills" / "handoff"
    rows, skipped = [], []
    if not root.is_dir():
        return rows, skipped
    for path in root.rglob("*.md"):
        if not path.is_file():
            continue
        if not inside(path, top):
            skipped.append(path)
            continue
        body = path.read_text(encoding="utf-8", errors="replace")
        stem = str(path.relative_to(root).with_suffix("")).replace("\\", "/")
        marks = sections_of(top, body, here_branch)
        if marks is not None:
            what = "checkpoint.md — " + ", ".join(marks)
        elif here_branch and stem == here_branch:
            what = f"{stem}.md — ←текущая"
        elif stem == "checkpoint" and not branch_alive(top, stem):
            what = "checkpoint.md"
        elif not branch_alive(top, stem):
            what = f"{stem}.md (сирота)"
        else:
            what = f"{stem}.md"
        stamped = written_at(body)
        rows.append({"what": what if stamped else what + "  [время файла]",
                     "when": stamped if stamped else path.stat().st_mtime})
    rows.sort(key=lambda r: r["when"], reverse=True)
    return rows, skipped


def show(rows, first=1):
    """Numbered in print order, so a number is a complete answer.

    The four hosts render a list four ways -- a menu in Kimi, prose in Claude
    and Codex, a table in OpenCode -- because the skill asked for "a list" and
    each host has its own affordance (2026-08-21). Numbers cost one column and
    make "3" an unambiguous choice everywhere, whatever the host draws.
    """
    for n, r in enumerate(rows, first):
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(r["when"]))
        print(f"  [{n}] {when}  {r['what']}")
    return first + len(rows)


def sources(args, here, known):
    """Which trees to list, and the one line saying where they came from."""
    if args.trees:
        return [repo_top(cwd=name) or Path(name) for name in args.trees], \
            "названы в командной строке"
    if args.all:
        return list(dict.fromkeys(([here] if here else []) + known)), \
            f"реестр {REGISTER}"
    if here:
        return [here], ""
    return known, f"реестр {REGISTER}"


def main():
    ap = argparse.ArgumentParser(
        description="Показать сохранённые чекпоинты и откуда они.")
    ap.add_argument("trees", nargs="*", help="каталоги деревьев; без них — "
                    "текущее дерево, а вне репозитория — реестр")
    ap.add_argument("--all", action="store_true",
                    help="все деревья реестра, даже когда вызван внутри одного")
    args = ap.parse_args()

    here = repo_top()
    here_branch = git("rev-parse", "--abbrev-ref", "HEAD")[1] if here else ""
    known, forgotten = registered()
    tops, source = sources(args, here, known)

    if not tops:
        print(f"primeskills-handoffs: чекпоинтов нет. Не внутри "
              f"git-репозитория, и реестр {REGISTER} пуст — он заполняется, "
              f"когда набор работает в дереве. Назовите дерево: "
              f"primeskills-handoffs <путь>")
        return 1

    listed, empty, skipped = [], [], []
    for top in tops:
        rows, links = rows_of(top, here_branch if top == here else "")
        skipped += links
        (listed if rows else empty).append(top)

    if not listed:
        print(f"primeskills-handoffs: в "
              f"{empty[0] / '.primeskills' / 'handoff'} нет ни одного .md — "
              f"сохранённых чекпоинтов нет.")
        for path in skipped:
            print(f"  пропущен {path}: ведёт по ссылке за пределы дерева")
        return 1

    trees = [(top, rows_of(top, here_branch if top == here else "")[0])
             for top in listed]
    total = sum(len(rows) for _, rows in trees)
    if len(trees) == 1 and not source:
        print(f"чекпоинты в {trees[0][0] / '.primeskills' / 'handoff'} "
              f"({total}), выбор по номеру:")
        show(trees[0][1])
    else:
        print(f"чекпоинтов {total} в {len(trees)} {trees_of(len(trees))} "
              f"({source}), выбор по номеру:")
        n = 1
        for top, rows in trees:
            print(f"{top}")
            n = show(rows, n)
    for path in skipped:
        print(f"  пропущен {path}: ведёт по ссылке за пределы дерева")
    if forgotten:
        print(f"в реестре ещё {forgotten}, где каталога чекпоинтов больше нет")
    if here and not args.all and not args.trees and len(known) > 1:
        print(f"ещё деревьев в реестре: {len(known) - 1} — "
              f"primeskills-handoffs --all")
    print("не коммитятся (PS-022) и живут только в своих деревьях")
    return 0


if __name__ == "__main__":
    sys.exit(main())
