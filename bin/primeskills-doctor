#!/usr/bin/env python3
"""Is the set actually wired up, in each agent, right now?

Written after two of the same failure in two days: core/ was written, budgeted
and reported as the shared base while no host ever loaded it; fence's hooks were
written and covered by 22 tests while nothing invoked them. Both were built,
verified in isolation, and never connected. The linter checks form, the tests
check logic, the status tool counts words -- none of them asks whether the thing
is switched on.

Exit 0 when every check passes.
"""
import json
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def under_root(path):
    """Ours by path components, not by substring: a sibling directory whose
    name merely starts with ours is not ours (same defect as the installer's)."""
    try:
        return Path(path).resolve().is_relative_to(ROOT)
    except (OSError, ValueError):
        return False
HOME = Path.home()
SKILLS = ROOT / "skills"
FENCE = SKILLS / "fence" / "bin"

OK, FAIL, WARN = "ok  ", "FAIL", "warn"


class Report:
    def __init__(self):
        self.failed = 0

    def line(self, status, agent, what, detail=""):
        if status == FAIL:
            self.failed += 1
        print(f"  [{status}] {agent:<10} {what}" + (f" — {detail}" if detail else ""))


def installed_skills(root):
    """Entries under `root` that resolve back into this repository."""
    if not root.is_dir():
        return []
    found = []
    for entry in sorted(root.iterdir()):
        skill = entry / "SKILL.md"
        if not skill.exists():
            continue
        if under_root(skill):
            found.append(entry.name)
    return found


def check_skills(r, agent, root):
    have, want = installed_skills(root), len(list(SKILLS.glob("*/SKILL.md")))
    if not have:
        r.line(FAIL, agent, "skills linked", f"none found in {root}")
    elif len(have) < want:
        r.line(FAIL, agent, "skills linked", f"{len(have)} of {want}")
    else:
        r.line(OK, agent, "skills linked", f"{len(have)}")


def check_core(r, agent, path, needle):
    if path is None or not path.is_file():
        r.line(FAIL, agent, "core reachable", f"{path} missing")
    elif needle in path.read_text(encoding="utf-8"):
        r.line(OK, agent, "core reachable", path.name)
    else:
        r.line(FAIL, agent, "core reachable", f"no pointer in {path.name}")


def check_guards(r):
    """The guards must refuse, not merely exist."""
    cases = [
        (FENCE / "check-commands.py", '{"tool_input":{"command":"rm -rf /var/data"}}', "ask",
         "destructive command"),
        (FENCE / "check-commands.py", "not json", "ask", "unreadable payload fails closed"),
    ]
    for script, payload, expect, what in cases:
        out = subprocess.run([sys.executable, str(script)], input=payload,
                             capture_output=True, text=True)
        got = (json.loads(out.stdout or "{}").get("hookSpecificOutput") or {}).get("permissionDecision")
        r.line(OK if got == expect else FAIL, "guards", what, f"decision={got}")


def check_pin(r):
    """Which tree the agents actually read. Unpinned is legitimate and it is
    also the state in which an edit here changes a running session."""
    pin = Path.home() / ".primeskills" / "pin.json"
    if not pin.is_file():
        r.line(WARN, "shared", "source of truth",
               "working copy — edits land in running sessions; --pin fixes a commit")
        return
    try:
        state = json.loads(pin.read_text(encoding="utf-8"))
    except ValueError:
        r.line(FAIL, "shared", "source of truth", "pin.json unreadable")
        return
    live = (Path.home() / ".primeskills" / "pinned").is_dir()
    r.line(OK if live else FAIL, "shared", "source of truth",
           f"pinned {state.get('commit', '?')[:8]}" if live
           else "pin.json points at a worktree that is gone")


def check_hooks_declared(r):
    """Read what is actually installed, not what the skill says about itself.

    This used to read fence/SKILL.md, so it reported green while the hook the
    host would really run was elsewhere or absent.
    """
    settings = Path.home() / ".claude" / "settings.json"
    installed = ""
    if settings.is_file():
        try:
            installed = json.dumps(json.loads(settings.read_text(encoding="utf-8")))
        except ValueError:
            installed = ""
    for matcher in ("Bash", "Edit|Write|NotebookEdit"):
        live = matcher in installed and str(ROOT) in installed
        r.line(OK if live else FAIL, "claude", f"hook armed for {matcher}",
               "in settings.json, every session" if live
               else "not in settings.json — run primeskills-install --apply")


def check_profile(r, agent, dest):
    """The read-only profile must be where the host looks, and be ours."""
    if not dest.exists():
        r.line(FAIL, agent, "prime-analyst profile", f"missing at {dest}")
    elif not under_root(dest):
        r.line(WARN, agent, "prime-analyst profile", "present but not ours")
    else:
        r.line(OK, agent, "prime-analyst profile", dest.parent.name + "/")


def check_command(r):
    """Skills name these tools by bare name. If the shell cannot find one, the
    instruction fails silently -- the exact failure this tool exists to catch."""
    for name, probe in (("primeskills-run", "--help"),
                        ("primeskills-help", "--which-lang")):
        found = shutil.which(name)
        if not found:
            r.line(FAIL, "shared", f"{name} on PATH", "not found")
            continue
        target = ROOT / "bin" / name
        if Path(found).resolve() != target.resolve():
            r.line(WARN, "shared", f"{name} on PATH", f"{found} is not ours")
            continue
        p = subprocess.run([sys.executable, str(target), probe],
                           capture_output=True, text=True)
        r.line(OK if p.returncode == 0 else FAIL, "shared", f"{name} on PATH", found)


def main():
    r = Report()
    print("primeskills doctor\n")

    check_skills(r, "claude", HOME / ".claude" / "skills")
    check_core(r, "claude", HOME / ".claude" / "CLAUDE.md", "primeskills:begin")
    check_pin(r)
    check_hooks_declared(r)

    check_skills(r, "codex", HOME / ".codex" / "skills")
    check_core(r, "codex", HOME / ".codex" / "AGENTS.md", "primeskills:begin")

    check_skills(r, "opencode", HOME / ".config" / "opencode" / "skills")
    cfg = HOME / ".config" / "opencode" / "opencode.json"
    if cfg.is_file():
        instructions = json.loads(cfg.read_text(encoding="utf-8")).get("instructions", [])
        hit = any("primeskills" in i for i in instructions)
        r.line(OK if hit else FAIL, "opencode", "core reachable",
               "in instructions" if hit else "not in instructions")
    else:
        r.line(WARN, "opencode", "core reachable", "no config")

    check_profile(r, "opencode", HOME / ".config" / "opencode" / "agents" / "prime-analyst.md")

    kimi = HOME / ".kimi-code" / "config.toml"
    if kimi.is_file():
        dirs = tomllib.loads(kimi.read_text(encoding="utf-8")).get("extra_skill_dirs", [])
        hit = str(SKILLS) in dirs
        r.line(OK if hit else FAIL, "kimi", "skills linked",
               "extra_skill_dirs" if hit else "path not listed")
        check_core(r, "kimi", HOME / ".kimi-code" / "AGENTS.md", "primeskills:begin")
        check_profile(r, "kimi", HOME / ".kimi-code" / "agents" / "prime-analyst.md")
    else:
        r.line(WARN, "kimi", "skills linked", "no config")

    check_guards(r)
    check_command(r)

    print(f"\n{r.failed} failed")
    return 1 if r.failed else 0


if __name__ == "__main__":
    sys.exit(main())
