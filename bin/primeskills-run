#!/usr/bin/env python3
"""Per-branch run record: what was proved, against which state of the tree.

Written because two external reviews landed on the same defect from different
directions. The G9 circuit breaker counts failed attempts "per problem, owned by
whoever runs the loop" -- but the owner died with the session, so the counter
reset every time context was cleared. And `release` claims "each stage reads the
previous one's evidence" while that evidence lived only in the conversation.

Records are bound to a state digest: the commit plus a hash of everything not
committed. Change one byte after a PASS and the record is stale, which is the
whole point -- a green run from an older tree is not evidence about this one.

The record is local. `.primeskills/` carries its own `.gitignore` covering
everything under it: `run/` names commands, targets and problems, and `handoff/`
carries blockers and dead ends. The handoff used to be committed so another
machine could pick the work up. Three external reviews landed on the same
consequence: it is read automatically at session start, so committing it lets
anyone who can push to a branch write the next agent's opening context.

    primeskills-run grant push "ветка feature/x, до PR"   # a rung the user opened
    primeskills-run may push                          # exits 1 when never granted
    primeskills-run revoke push
    primeskills-run note verify "pytest -q: 1119 passed, exit 0"
    primeskills-run fail "export renders 4 pages"     # exits 3 on the third
    primeskills-run clear "export renders 4 pages"
    primeskills-run check verify                      # exits 2 when stale
    primeskills-run show
"""
import hashlib
import json
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

BREAKER = 3  # G9: three failed attempts on one problem and the loop stops
BIG_FILE = 4 * 1024 * 1024  # past this, an untracked file is hashed by size+mtime
# The rungs of the authority ladder, in order. Each is a separate yes and one
# never implies the next; `may` refuses anything not on this list rather than
# guessing what a new word means.
RUNGS = ("commit", "push", "pr", "merge", "deploy", "rollback", "delete")
IGNORE = "# Written by skills, read by skills, and never committed.\n" \
         "# run/ names commands, targets and problems. handoff/ carries blockers,\n" \
         "# dead ends and internal context — and a committed handoff is read by\n" \
         "# the next agent as context, so anyone who can push to the branch can\n" \
         "# write it.\n*\n"


def git(*args):
    p = subprocess.run(("git",) + args, capture_output=True, text=True)
    return p.stdout if p.returncode == 0 else ""


def untracked_content():
    """Bytes of every untracked file, not just its name.

    `git status --porcelain` names an untracked file and says nothing about
    what is in it, so a PASS stayed fresh while the new module under test was
    rewritten -- the one hole in the idea that evidence expires with the tree.
    Ignored files are still outside the digest: they are excluded on purpose
    and walking them would drag node_modules into every check.
    """
    out = hashlib.sha1()
    for line in git("status", "--porcelain", "-z").split("\0"):
        if not line.startswith("?? "):
            continue
        target = Path(line[3:])
        files = sorted(target.rglob("*")) if target.is_dir() else [target]
        for f in files:
            if not f.is_file() or f.is_symlink():
                continue
            out.update(str(f).encode("utf-8"))
            # Hashing every untracked byte on every call turns a note into a
            # scan of whatever the tree happens to be carrying. Past the cap,
            # size and mtime stand in: they still change when the file does,
            # and they cost nothing.
            try:
                stat = f.stat()
            except OSError:
                continue
            if stat.st_size > BIG_FILE:
                out.update(f"{stat.st_size}:{stat.st_mtime_ns}".encode("utf-8"))
                continue
            with f.open("rb") as fh:
                for chunk in iter(lambda: fh.read(65536), b""):
                    out.update(chunk)
    return out.hexdigest()


def state_digest():
    """Commit plus everything not in it. Two runs share a digest only when the
    tree they ran against is byte-identical."""
    commit = git("rev-parse", "HEAD").strip() or "no-commit"
    pending = git("diff", "HEAD") + git("status", "--porcelain") + untracked_content()
    return commit, hashlib.sha1(pending.encode("utf-8")).hexdigest()[:12]


def record_path():
    top = git("rev-parse", "--show-toplevel").strip()
    if not top:
        sys.exit("primeskills-run: not inside a git repository")
    branch = git("rev-parse", "--abbrev-ref", "HEAD").strip() or "detached"
    root = Path(top) / ".primeskills" / "run"
    root.mkdir(parents=True, exist_ok=True)
    ignore = root.parent / ".gitignore"
    if not ignore.is_file():
        ignore.write_text(IGNORE, encoding="utf-8")
    return root / (slug(branch) + ".jsonl")


def slug(text):
    s = re.sub(r"[^a-zA-Z0-9._-]+", "-", text.strip()).strip("-")
    return (s or "unnamed")[:60]


def read(path):
    if not path.is_file():
        return []
    out = []
    for line in path.read_text(encoding="utf-8").splitlines():
        try:
            out.append(json.loads(line))
        except ValueError:
            continue
    return out


def append(path, entry):
    commit, digest = state_digest()
    entry.update({"ts": datetime.now(timezone.utc).isoformat(timespec="seconds"),
                  "commit": commit, "state": digest})
    with path.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(entry, ensure_ascii=False) + "\n")
    return entry


# Words that carry no problem in them. Kept short on purpose: a long list
# starts merging problems that differ only by a word it decided was filler.
FILLER = {"the", "a", "an", "is", "are", "was", "were", "this", "that", "it",
          "its", "and", "or", "of", "to", "in", "on", "at", "for", "with",
          "when", "after", "before", "again", "still", "now", "not"}
# Share of shared words at which two phrasings are one problem. 0.5 merged
# "export renders 4 pages" with "export fails on 4 pages" -- two different bugs
# on one counter, which trips the breaker on one and a half real attempts. That
# is the failure PS-020 already recorded from the other side, so the threshold
# now errs towards splitting: a wrongly split counter costs an extra attempt, a
# wrongly merged one stops work that was going fine.
SAME_PROBLEM = 0.75


def problem_tokens(text):
    words = re.findall(r"\w+", text.lower(), re.UNICODE)
    return {w for w in words if len(w) > 2 and w not in FILLER}


def problem_key(text):
    return " ".join(sorted(problem_tokens(text)))


def match_key(counts, text):
    """Which open counter this phrasing belongs to.

    The breaker is keyed by a string the agent types, so `fail "login 500"` and
    `fail "the login endpoint returns 500"` were two problems and three attempts
    quietly became six -- the one mechanism holding the worst loop was defeated
    by a synonym. Now a new phrasing joins the closest open counter when they
    share half their words. This narrows the hole; a genuinely different
    description still opens a new counter, and no string comparison would fix
    that. The ceiling is in docs/ADAPTERS.md.
    """
    tokens = problem_tokens(text)
    best, score = None, 0.0
    for key in counts:
        other = set(key.split())
        if tokens and other:
            overlap = len(tokens & other) / len(tokens | other)
            if overlap > score:
                best, score = key, overlap
    return best if score >= SAME_PROBLEM else problem_key(text)


def counters(entries):
    counts = {}
    for e in entries:
        key = match_key(counts, e.get("problem", ""))
        if e.get("kind") == "fail":
            counts[key] = counts.get(key, 0) + 1
        elif e.get("kind") == "clear":
            counts.pop(key, None)
    return counts


def cmd_note(path, argv):
    if len(argv) < 2:
        sys.exit("usage: primeskills-run note <stage> <text>")
    e = append(path, {"kind": "note", "stage": argv[0], "text": " ".join(argv[1:])})
    print(f"{argv[0]} recorded against {e['commit'][:8]}+{e['state']}")
    return 0


def cmd_fail(path, argv):
    if not argv:
        sys.exit("usage: primeskills-run fail <problem>")
    problem = " ".join(argv)
    append(path, {"kind": "fail", "problem": problem})
    counts = counters(read(path))
    n = counts.get(match_key(counts, problem), 0)
    if n >= BREAKER:
        print(f"{problem}: {n} — G9 breaker. Restore the G14 snapshot, report "
              f"what each attempt ruled out, ask.")
        return 3
    print(f"{problem}: {n} of {BREAKER}")
    return 0


def cmd_clear(path, argv):
    if not argv:
        sys.exit("usage: primeskills-run clear <problem>")
    problem = " ".join(argv)
    if match_key(counters(read(path)), problem) not in counters(read(path)):
        print(f"{problem}: no counter")
        return 0
    append(path, {"kind": "clear", "problem": problem})
    print(f"{problem}: cleared")
    return 0


def mandates(entries):
    """rung -> the entry that opened it, minus anything revoked since."""
    out = {}
    for e in entries:
        if e.get("kind") == "grant":
            out[e["rung"]] = e
        elif e.get("kind") == "revoke":
            out.pop(e.get("rung"), None)
    return out


def cmd_grant(path, argv):
    """Record that the user opened a rung, and for what.

    The ladder in GUARDRAILS says each rung is a separate yes. It was being
    walked anyway, because permission lived in the conversation and the body of
    a skill said "commit atomically" with no way to tell whether anyone had
    agreed. Writing it down does not create authority -- it makes the claim to
    it checkable, and survives the session that heard it.
    """
    if not argv or argv[0] not in RUNGS:
        sys.exit(f"usage: primeskills-run grant <{'|'.join(RUNGS)}> [scope]")
    rung, scope = argv[0], " ".join(argv[1:]).strip()
    if not scope:
        sys.exit("grant needs a scope: what the permission covers, in the "
                 "user's own words. An unbounded yes is not a yes.")
    e = append(path, {"kind": "grant", "rung": rung, "scope": scope})
    print(f"{rung}: granted — {scope} (recorded against {e['commit'][:8]})")
    return 0


def cmd_revoke(path, argv):
    if not argv or argv[0] not in RUNGS:
        sys.exit(f"usage: primeskills-run revoke <{'|'.join(RUNGS)}>")
    rung = argv[0]
    if rung not in mandates(read(path)):
        print(f"{rung}: not granted")
        return 0
    append(path, {"kind": "revoke", "rung": rung})
    print(f"{rung}: revoked")
    return 0


def cmd_may(path, argv):
    """Exit 0 when the rung is open, 1 when it is not. Meant for a skill step."""
    if not argv or argv[0] not in RUNGS:
        sys.exit(f"usage: primeskills-run may <{'|'.join(RUNGS)}>")
    rung = argv[0]
    hit = mandates(read(path)).get(rung)
    if not hit:
        print(f"{rung}: not granted on this branch. Ask, then "
              f"`primeskills-run grant {rung} \"<what the user allowed>\"`.")
        return 1
    print(f"{rung}: granted — {hit['scope']}")
    return 0


def cmd_check(path, argv):
    """Is the newest record for this stage still about the tree in front of us?"""
    if not argv:
        sys.exit("usage: primeskills-run check <stage>")
    stage = argv[0]
    hits = [e for e in read(path) if e.get("kind") == "note" and e.get("stage") == stage]
    if not hits:
        print(f"{stage}: nothing recorded")
        return 1
    last = hits[-1]
    commit, digest = state_digest()
    if last["commit"] == commit and last["state"] == digest:
        print(f"{stage}: current — {last['text']}")
        return 0
    what = "the commit" if last["commit"] != commit else "uncommitted work"
    print(f"{stage}: STALE. Recorded against {last['commit'][:8]}+{last['state']}, "
          f"now {commit[:8]}+{digest} — {what} changed since. Run it again.")
    return 2


def cmd_show(path):
    entries = read(path)
    if not entries:
        print("nothing recorded yet")
        return 0
    commit, digest = state_digest()
    print(f"# Run record — {path.stem}\n")
    print(f"Tree now: {commit[:8]}+{digest}\n")
    open_rungs = mandates(entries)
    print("## Authority\n")
    if open_rungs:
        for rung in RUNGS:
            if rung in open_rungs:
                print(f"- **{rung}** — {open_rungs[rung]['scope']}")
    else:
        print("- nothing granted: every rung of the ladder still asks")
    print()
    counts = counters(entries)
    if counts:
        print("## Counters\n")
        for k, v in sorted(counts.items()):
            print(f"- {k} — {v}")
        print()
    print("## Log\n")
    for e in entries:
        mark = "" if e.get("state") == digest and e.get("commit") == commit else "  (stale)"
        if e["kind"] == "note":
            print(f"- **{e['stage']}** ({e['ts']}) — {e['text']}{mark}")
        elif e["kind"] == "fail":
            print(f"- **attempt** ({e['ts']}) — failed on: {e['problem']}{mark}")
        elif e["kind"] == "grant":
            print(f"- **granted** ({e['ts']}) — {e['rung']}: {e['scope']}")
        elif e["kind"] == "revoke":
            print(f"- **revoked** ({e['ts']}) — {e['rung']}")
        else:
            print(f"- **cleared** ({e['ts']}) — {e['problem']}")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    action, rest = argv[0], argv[1:]
    path = record_path()
    if action == "start":
        path.touch()  # `start` means the record exists, not that a path was computed
        print(path)
        return 0
    if action == "show":
        return cmd_show(path)
    if action == "note":
        return cmd_note(path, rest)
    if action == "fail":
        return cmd_fail(path, rest)
    if action == "clear":
        return cmd_clear(path, rest)
    if action == "check":
        return cmd_check(path, rest)
    if action == "grant":
        return cmd_grant(path, rest)
    if action == "revoke":
        return cmd_revoke(path, rest)
    if action == "may":
        return cmd_may(path, rest)
    sys.exit(f"primeskills-run: unknown action {action!r}")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
