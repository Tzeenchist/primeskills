#!/usr/bin/env python3
"""Per-branch run record: what was proved, against which state of the tree.

Written because two external reviews landed on the same defect from different
directions. The G12 circuit breaker counts failed attempts "per problem, owned by
whoever runs the loop" -- but the owner died with the session, so the counter
reset every time context was cleared. And `release` claims "each stage reads the
previous one's evidence" while that evidence lived only in the conversation.

Records are bound to a state digest: the commit plus a hash of everything not
committed. Change one byte after a PASS and the record is stale, which is the
whole point -- a green run from an older tree is not evidence about this one.

The record is local. `.primeskills/` carries its own `.gitignore` covering
everything under it: `run/` names commands, targets and problems, and `handoff/`
carries blockers and dead ends. The handoff used to be committed so another
machine could pick the work up. Three external reviews landed on the same
consequence: it is read automatically at session start, so committing it lets
anyone who can push to a branch write the next agent's opening context.

    primeskills-run grant push "ветка feature/x, до PR"   # a rung the user opened
    primeskills-run grant deploy --target staging "релиз 0.4"  # named, one use
    primeskills-run may push                          # exits 1 when never granted
    primeskills-run may deploy --target staging       # target must match
    primeskills-run revoke push
    primeskills-run note verify "pytest -q: 1119 passed, exit 0"
    primeskills-run fail "export renders 4 pages"     # exits 3 on the third
    primeskills-run clear "export renders 4 pages"
    primeskills-run check verify                      # exits 2 when stale
    PRIMESKILLS_CHAIN_STATE=1 primeskills-run may push # stale verify blocks land
    primeskills-run show

Evidence of a run (notes, G12 counters) is per branch. Permissions (grant,
revoke, spent) live in one record per repository, `run/repo.jsonl`: `land` and
`merge` cross branches by design, and a mandate written on master was
invisible from the branch the merge ran on (PS-047). 0.5.x also read the
per-branch record so an update mid-work would not close an open rung; 0.6.0
reads only the ledger.
"""
import hashlib
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

BREAKER = 3  # G12: three failed attempts on one problem and the loop stops
BIG_FILE = 4 * 1024 * 1024  # past this, hash size plus 64 KiB at each end
SAMPLE_SIZE = 64 * 1024
# The rungs of the authority ladder, in order. Each is a separate yes and one
# never implies the next; `may` refuses anything not on this list rather than
# guessing what a new word means.
RUNGS = ("commit", "push", "pr", "merge", "migrate", "deploy", "rollback",
         "delete", "clear")
# Rungs where a mandate must name what it covers and is spent when used. A
# migration is often irreversible where the deploy around it is not, so it
# carries its own yes rather than riding on deploy's. `clear` is here for a
# different reason: it lifts the G12 breaker, and a breaker its own subject can
# lift is a reminder, not a breaker. Its target is the problem being cleared,
# so one yes clears one counter and not the next one.
SENSITIVE = ("migrate", "deploy", "rollback", "delete", "clear")
LIFETIME = {"sensitive": 60, "ordinary": 480}  # minutes
CHAIN_STATE_FLAG = "PRIMESKILLS_CHAIN_STATE"
CHAIN_STATE_RUNGS = ("push", "pr")
IGNORE = "# Written by skills, read by skills, and never committed.\n" \
         "# run/ names commands, targets and problems. handoff/ carries blockers,\n" \
         "# dead ends and internal context — and a committed handoff is read by\n" \
         "# the next agent as context, so anyone who can push to the branch can\n" \
         "# write it.\n*\n"


def git(*args):
    p = subprocess.run(("git",) + args, capture_output=True, text=True)
    return p.stdout if p.returncode == 0 else ""


def hash_path(out, path, display):
    """Add one repository path without ever following a symbolic link.

    The name is terminated rather than run straight into the bytes that follow
    it. Without the terminator the two halves are one string and a rename can
    pay for a content change: `a.py` holding "z" and an empty `a.pyz` hash the
    same. Untracked files were covered by accident -- their names also reach the
    digest through `git status` -- but digest-include paths appear nowhere else,
    so for them the ambiguity was live. NUL cannot occur in a path, so the
    boundary is unambiguous even when the content carries one.
    """
    out.update(str(display).encode("utf-8"))
    out.update(b"\0")
    if path.is_symlink():
        try:
            target = os.readlink(path)
        except OSError:
            return
        out.update(b"\0link\0")
        out.update(target.encode("utf-8"))
        return
    try:
        stat = path.stat()
    except OSError:
        return
    if not path.is_file():
        return
    with path.open("rb") as fh:
        if stat.st_size > BIG_FILE:
            out.update(f"{stat.st_size}:".encode("utf-8"))
            out.update(fh.read(SAMPLE_SIZE))
            fh.seek(-SAMPLE_SIZE, os.SEEK_END)
            out.update(fh.read(SAMPLE_SIZE))
            return
        for chunk in iter(lambda: fh.read(65536), b""):
            out.update(chunk)


def untracked_content():
    """Bytes of every untracked file, not just its name.

    `git status --porcelain` names an untracked file and says nothing about
    what is in it, so a PASS stayed fresh while the new module under test was
    rewritten -- the one hole in the idea that evidence expires with the tree.
    Ignored files are handled separately and only when digest-include names
    them, so this walk cannot drag node_modules into every check.
    """
    out = hashlib.sha1()
    for line in git("status", "--porcelain", "-z").split("\0"):
        if not line.startswith("?? "):
            continue
        target = Path(line[3:])
        files = (sorted(target.rglob("*"))
                 if target.is_dir() and not target.is_symlink() else [target])
        for f in files:
            hash_path(out, f, f)
    return out.hexdigest()


def included_content():
    """Content selected by .primeskills/digest-include, rooted at the repo."""
    top = Path(git("rev-parse", "--show-toplevel").strip())
    include = top / ".primeskills" / "digest-include"
    if not include.is_file() or include.is_symlink():
        return ""
    out = hashlib.sha1()
    paths = set()
    for raw in include.read_text(encoding="utf-8").splitlines():
        pattern = raw.strip()
        if not pattern or pattern.startswith("#"):
            continue
        if Path(pattern).is_absolute() or ".." in Path(pattern).parts:
            continue
        out.update(pattern.encode("utf-8"))
        for match in top.glob(pattern):
            parent = top
            linked_parent = False
            for part in match.relative_to(top).parts[:-1]:
                parent /= part
                if parent.is_symlink():
                    linked_parent = True
                    break
            if linked_parent:
                continue
            paths.add(match)
            if match.is_dir() and not match.is_symlink():
                paths.update(match.rglob("*"))
    for path in sorted(paths):
        hash_path(out, path, path.relative_to(top))
    return out.hexdigest()


def state_digest():
    """Commit plus the uncommitted tree inputs that a test run can prove.

    Tracked changes come from git; untracked files contribute content, with
    files past BIG_FILE represented by size and 64 KiB from each end. Ignored
    paths contribute content only when a repository-root glob in
    .primeskills/digest-include selects them. Symbolic links contribute their
    path and link target, never bytes reached through the link: following one
    could read outside the repository, the same trust break no_symlink()
    refuses for the run journal. A binary tracked file still reaches us as
    git's "files differ" line. README documents the same boundary."""
    commit = git("rev-parse", "HEAD").strip() or "no-commit"
    pending = (git("diff", "HEAD") + git("status", "--porcelain")
               + untracked_content() + included_content())
    return commit, hashlib.sha1(pending.encode("utf-8")).hexdigest()[:12]


def current_branch():
    return git("rev-parse", "--abbrev-ref", "HEAD").strip() or "detached"


def no_symlink(path, top):
    """Refuse a journal path that leaves the repository, or leads out by link.

    The journal is read back as the basis for permissions and for "the tests
    were green", so where it lives is part of what it proves. A cloned
    repository can ship `.primeskills` as a symlink and take both: the writes
    land in a file it controls, and the grants it planted there are read as the
    user's own. Checked on every component, because a link one level up is the
    same trick one level up.
    """
    if path.is_symlink():
        sys.exit(f"primeskills-run: {path} is a symlink. The run journal is "
                 f"refused outside the repository — remove the link or the "
                 f"record it points at.")
    try:
        path.resolve().relative_to(top.resolve())
    except ValueError:
        sys.exit(f"primeskills-run: {path} resolves outside {top}. The journal "
                 f"is only trusted inside the repository it describes.")


def record_path():
    top = git("rev-parse", "--show-toplevel").strip()
    if not top:
        sys.exit("primeskills-run: not inside a git repository")
    top = Path(top)
    branch = git("rev-parse", "--abbrev-ref", "HEAD").strip() or "detached"
    root = top / ".primeskills" / "run"
    for part in (root.parent, root):
        if part.exists() or part.is_symlink():
            no_symlink(part, top)
    root.mkdir(parents=True, exist_ok=True)
    ignore = root.parent / ".gitignore"
    if not ignore.is_file():
        ignore.write_text(IGNORE, encoding="utf-8")
        # Writing into someone else's repository without a word is not the same
        # as writing inside our own boundary. Say it once, do not ask: a prompt
        # on every new repository costs more than the file it guards.
        print(f"primeskills-run: создан {ignore} — записи прогона и чекпоинты "
              f"остаются локальными", file=sys.stderr)
    record = root / (slug(branch) + ".jsonl")
    if record.exists() or record.is_symlink():
        no_symlink(record, top)
    return record


def slug(text):
    """A readable file name that still tells branches apart.

    The readable part alone was lossy: `feature/a` and `feature-a` became the
    same name, so did any two branches sharing their first sixty characters,
    and every detached HEAD became `detached`. Two branches sharing a journal
    share their permissions and their attempt counters, which is the opposite
    of what the journal is for. The suffix is a hash of the full name.
    """
    plain = re.sub(r"[^a-zA-Z0-9._-]+", "-", text.strip()).strip("-")
    mark = hashlib.sha1(text.encode("utf-8")).hexdigest()[:8]
    return f"{(plain or 'unnamed')[:60]}-{mark}"


def read(path, strict=False):
    """Entries of one record.

    A line that does not parse is corruption, not absence. Where the record is
    read as a lock — `may`, `check`, `show` — skipping it silently widens the
    gate: a truncated `spent` line resurrects a one-use mandate, and the
    `fence` hook declines a command when the journal does not answer. Strict
    readers refuse and name the line.
    """
    if not path.is_file():
        return []
    out = []
    for n, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        try:
            out.append(json.loads(line))
        except ValueError:
            if strict:
                sys.exit(f"primeskills-run: {path}: строка {n} не читается — "
                         f"запись испорчена, отказ.")
    return out


def ledger_path(record):
    """The one permissions record per repository: grants, revokes, spends.

    They used to live in the per-branch record, and `land`/`merge` cross
    branches by design — a mandate written on master was invisible from the
    branch, and one written on the branch was invisible from the base
    (PS-047). Evidence and G12 counters stay per branch; authority is granted
    to the work, not to the branch.
    """
    ledger = record.with_name("repo.jsonl")
    if ledger.exists() or ledger.is_symlink():
        no_symlink(ledger, record.parents[2])
    return ledger


def permission_entries(record):
    """Grant history, oldest first. One record per repository.

    0.5.x also read the per-branch record older versions wrote grants into, so
    that updating mid-work would not silently close an open rung. That window
    is closed in 0.6.0 (PS-047): a mandate written by an older version into a
    branch record is no longer seen, and the rung has to be granted again. The
    longest mandate lives 480 minutes, so nothing older than the transition can
    still be open — what is dropped is expired by construction.
    """
    return sorted(read(ledger_path(record), strict=True),
                  key=lambda e: e.get("ts", ""))


def append(path, entry):
    commit, digest = state_digest()
    entry.update({"ts": datetime.now(timezone.utc).isoformat(timespec="seconds"),
                  "commit": commit, "state": digest})
    # O_NOFOLLOW closes the window between the check in record_path and this
    # write: a link planted in between would otherwise be followed here.
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(entry, ensure_ascii=False) + "\n")
    return entry


# Words that carry no problem in them. Kept short on purpose: a long list
# starts merging problems that differ only by a word it decided was filler.
FILLER = {"the", "a", "an", "is", "are", "was", "were", "this", "that", "it",
          "its", "and", "or", "of", "to", "in", "on", "at", "for", "with",
          "when", "after", "before", "again", "still", "now", "not"}
# Share of shared words at which two phrasings are one problem. 0.5 merged
# "export renders 4 pages" with "export fails on 4 pages" -- two different bugs
# on one counter, which trips the breaker on one and a half real attempts. That
# is the failure PS-020 already recorded from the other side, so the threshold
# now errs towards splitting: a wrongly split counter costs an extra attempt, a
# wrongly merged one stops work that was going fine.
SAME_PROBLEM = 0.75


def problem_tokens(text):
    words = re.findall(r"\w+", text.lower(), re.UNICODE)
    return {w for w in words if len(w) > 2 and w not in FILLER}


def problem_key(text):
    return " ".join(sorted(problem_tokens(text)))


def match_key(counts, text):
    """Which open counter this phrasing belongs to.

    The breaker is keyed by a string the agent types, so `fail "login 500"` and
    `fail "the login endpoint returns 500"` were two problems and three attempts
    quietly became six -- the one mechanism holding the worst loop was defeated
    by a synonym. Now a new phrasing joins the closest open counter when they
    share half their words. This narrows the hole; a genuinely different
    description still opens a new counter, and no string comparison would fix
    that. The ceiling is in docs/ADAPTERS.md.
    """
    tokens = problem_tokens(text)
    best, score = None, 0.0
    for key in counts:
        other = set(key.split())
        if tokens and other:
            overlap = len(tokens & other) / len(tokens | other)
            if overlap > score:
                best, score = key, overlap
    return best if score >= SAME_PROBLEM else problem_key(text)


def counters(entries):
    counts = {}
    for e in entries:
        key = match_key(counts, e.get("problem", ""))
        if e.get("kind") == "fail":
            counts[key] = counts.get(key, 0) + 1
        elif e.get("kind") == "clear":
            counts.pop(key, None)
    return counts


def cmd_note(path, argv):
    if len(argv) < 2:
        sys.exit("usage: primeskills-run note <stage> <text>")
    e = append(path, {"kind": "note", "stage": argv[0], "text": " ".join(argv[1:])})
    print(f"{argv[0]} recorded against {e['commit'][:8]}+{e['state']}")
    return 0


def cmd_fail(path, argv):
    if not argv:
        sys.exit("usage: primeskills-run fail <problem>")
    problem = " ".join(argv)
    append(path, {"kind": "fail", "problem": problem})
    counts = counters(read(path))
    n = counts.get(match_key(counts, problem), 0)
    if n >= BREAKER:
        print(f"{problem}: {n} — G12 breaker. Restore the G11 snapshot, report "
              f"what each attempt ruled out, ask.")
        return 3
    print(f"{problem}: {n} of {BREAKER}")
    return 0


def cmd_clear(path, argv):
    """Reset one G12 counter -- on the user's yes, never on the agent's own.

    The rung is `clear` and its target is the problem, so the permission that
    lifts the breaker on one failure does not lift it on the next. The target
    is matched exactly, not by the fuzzy rule the counters use: a counter may
    be found by a rephrasing, but a permission must not.
    """
    if not argv:
        sys.exit("usage: primeskills-run clear <problem>")
    problem = " ".join(argv)
    live = counters(read(path))
    if match_key(live, problem) not in live:
        print(f"{problem}: no counter")
        return 0
    code, message = rung_state(path, "clear", problem)
    if code:
        print(message)
        if live:
            print("counters right now: " + ", ".join(repr(k) for k in live))
        return code
    append(path, {"kind": "clear", "problem": problem})
    print(f"{problem}: cleared ({message.split('— ', 1)[-1]})")
    return 0


def age_minutes(entry):
    then = datetime.fromisoformat(entry["ts"])
    return (datetime.now(timezone.utc) - then).total_seconds() / 60


def open_grants(entries):
    """rung -> the entry that opened it: not revoked, not spent.

    Expiry is answered by the caller on purpose: an expired mandate must say
    it expired, not read as never granted — «not granted» sends the user
    looking for a grant they already gave.
    """
    out = {}
    for e in entries:
        kind, rung = e.get("kind"), e.get("rung")
        if kind == "grant":
            out[rung] = e
        elif kind in ("revoke", "spent"):
            out.pop(rung, None)
    return out


def mandates(entries, at=None):
    """rung -> the entry that opened it: not revoked, not spent, not expired.

    A permission with no end is a switch wearing a ladder's clothes. The first
    version stored one and answered `granted` a month later, which sat badly
    next to deploy's own invariant that prior permission for one deploy is not
    permission for the next.
    """
    return {rung: e for rung, e in open_grants(entries).items()
            if age_minutes(e) <= e.get("lifetime", LIFETIME["ordinary"])}


def cmd_grant(path, argv):
    """Record that the user opened a rung, and for what.

    The ladder in GUARDRAILS says each rung is a separate yes. It was being
    walked anyway, because permission lived in the conversation and the body of
    a skill said "commit atomically" with no way to tell whether anyone had
    agreed. Writing it down does not create authority -- it makes the claim to
    it checkable, and survives the session that heard it.

    It is a journal, not an authorization gate, and the difference matters:
    anything that can run this command can write a grant, including the agent
    the grant is meant to restrain, and two `may` checks racing each other can
    spend one single-use permission twice. Reviewed and stated plainly on
    2026-08-18 rather than left for a reader to discover. The gate that holds
    is the host's own confirmation at the moment of the operation.
    """
    if not argv or argv[0] not in RUNGS:
        sys.exit(f"usage: primeskills-run grant <{'|'.join(RUNGS)}> "
                 f"[--target <what>] [--for <minutes>] <scope>")
    rung, rest = argv[0], argv[1:]
    target, minutes = None, None
    words = []
    i = 0
    while i < len(rest):
        if rest[i] == "--target" and i + 1 < len(rest):
            target, i = rest[i + 1], i + 2
        elif rest[i] == "--for" and i + 1 < len(rest):
            minutes, i = rest[i + 1], i + 2
        else:
            words.append(rest[i]); i += 1
    scope = " ".join(words).strip()
    if not scope:
        sys.exit("grant needs a scope: what the permission covers, in the "
                 "user's own words. An unbounded yes is not a yes.")
    if rung in SENSITIVE and not target:
        sys.exit(f"{rung} needs --target: the environment, host or database this "
                 f"covers. 'deploy staging' must not open the door to production.")
    try:
        lifetime = int(minutes) if minutes else LIFETIME[
            "sensitive" if rung in SENSITIVE else "ordinary"]
    except ValueError:
        sys.exit("--for takes minutes as a number")
    e = append(ledger_path(path), {"kind": "grant", "rung": rung, "scope": scope,
                                   "target": target, "lifetime": lifetime,
                                   "branch": current_branch(),
                                   "once": rung in SENSITIVE})
    once = ", one use" if rung in SENSITIVE else ""
    at = f" for {target}" if target else ""
    print(f"{rung}: granted{at} — {scope} ({lifetime} min{once}, "
          f"recorded against {e['commit'][:8]})")
    return 0


def cmd_revoke(path, argv):
    if not argv or argv[0] not in RUNGS:
        sys.exit(f"usage: primeskills-run revoke <{'|'.join(RUNGS)}>")
    rung = argv[0]
    if rung not in mandates(permission_entries(path)):
        print(f"{rung}: not granted")
        return 0
    append(ledger_path(path), {"kind": "revoke", "rung": rung})
    print(f"{rung}: revoked")
    return 0


def rung_state(path, rung, target, spend=True, peek=False):
    """Is this rung open, for this target, right now? (code, message).

    Shared by `may` and `clear` on purpose. When `clear` did its own reading of
    the journal it did no reading at all: the command that lifts the G12 breaker
    was the one command on no rung, so the agent the breaker stops could stop
    the breaker. One path also means one place where a single-use mandate is
    spent, instead of two that can disagree about whether it was.
    """
    hit = open_grants(permission_entries(path)).get(rung)
    if not hit:
        return 1, (f"{rung}: not granted. Ask, then "
                   f"`primeskills-run grant {rung} \"<what the user allowed>\"`.")
    lifetime = hit.get("lifetime", LIFETIME["ordinary"])
    age = age_minutes(hit)
    if age > lifetime:
        return 1, (f"{rung}: истёк {int(age)} мин назад (мандат был выдан на "
                   f"{lifetime} мин). Ask, then `primeskills-run grant {rung} "
                   f"\"<what the user allowed>\"`.")
    # A peek with no target of its own asks a different question: "is anything
    # open here, and for what?" It gets the mandate's target back and compares
    # on its own terms -- the `fence` hook knows the command, not the wording
    # the user chose.
    if hit.get("target") and not (peek and target is None) and hit["target"] != target:
        return 1, (f"{rung}: granted for {hit['target']!r}, asked for {target!r}. "
                   f"A permission for one target is not a permission for another.")
    if rung in SENSITIVE and not target and not peek:
        return 1, f"{rung}: name the target — `may {rung} --target <what>`."
    spent = ""
    if hit.get("once") and spend:
        append(ledger_path(path), {"kind": "spent", "rung": rung})
        spent = ", spent by this check"
    named = f" target={hit['target']}" if peek and hit.get("target") else ""
    return 0, (f"{rung}: granted{named} — {hit['scope']} "
               f"(выдан {int(age)} мин назад{spent})")


def cmd_may(path, argv):
    """Exit 0 when the rung is open, 1 when it is not. Meant for a skill step.

    `--peek` answers the same question without spending a single-use mandate.
    It exists for the `fence` hook, which is asked on every command and must not
    consume a permission just by looking at one.
    """
    if not argv or argv[0] not in RUNGS:
        sys.exit(f"usage: primeskills-run may <{'|'.join(RUNGS)}> "
                 f"[--target <what>] [--peek]")
    rung = argv[0]
    target = argv[argv.index("--target") + 1] if "--target" in argv[1:] else None
    peek = "--peek" in argv
    code, message = rung_state(path, rung, target, spend=not peek, peek=peek)
    print(message)
    if code:
        return code
    # `land` verifies before committing, but the commit changes the state the
    # proof names. Its next existing machine gates are push and PR. Behind the
    # rollout flag, make either refuse until verify records the committed tree.
    if (os.environ.get(CHAIN_STATE_FLAG) == "1"
            and rung in CHAIN_STATE_RUNGS):
        return cmd_check(path, ["verify"])
    return code


def cmd_check(path, argv):
    """Is the newest record for this stage still about the tree in front of us?"""
    if not argv:
        sys.exit("usage: primeskills-run check <stage>")
    stage = argv[0]
    hits = [e for e in read(path, strict=True)
            if e.get("kind") == "note" and e.get("stage") == stage]
    if not hits:
        print(f"{stage}: nothing recorded")
        return 1
    last = hits[-1]
    commit, digest = state_digest()
    if last["commit"] == commit and last["state"] == digest:
        print(f"{stage}: current — {last['text']}")
        return 0
    what = "the commit" if last["commit"] != commit else "uncommitted work"
    print(f"{stage}: STALE. Recorded against {last['commit'][:8]}+{last['state']}, "
          f"now {commit[:8]}+{digest} — {what} changed since. Run it again.")
    return 2


def cmd_show(path):
    entries = permission_entries(path)
    if not entries:
        print("nothing recorded yet")
        return 0
    commit, digest = state_digest()
    print(f"# Run record — {path.stem}\n")
    print(f"Tree now: {commit[:8]}+{digest}\n")
    open_rungs = mandates(entries)
    print("## Заявленные полномочия (журнал, не гейт)\n")
    if open_rungs:
        for rung in RUNGS:
            if rung in open_rungs:
                print(f"- **{rung}** — {open_rungs[rung]['scope']}")
    else:
        print("- nothing granted: every rung of the ladder still asks")
    print()
    counts = counters(entries)
    if counts:
        print("## Counters\n")
        for k, v in sorted(counts.items()):
            print(f"- {k} — {v}")
        print()
    print("## Log\n")
    for e in entries:
        mark = "" if e.get("state") == digest and e.get("commit") == commit else "  (stale)"
        if e["kind"] == "note":
            print(f"- **{e['stage']}** ({e['ts']}) — {e['text']}{mark}")
        elif e["kind"] == "fail":
            print(f"- **attempt** ({e['ts']}) — failed on: {e['problem']}{mark}")
        elif e["kind"] == "grant":
            print(f"- **granted** ({e['ts']}) — {e['rung']}: {e['scope']}")
        elif e["kind"] == "revoke":
            print(f"- **revoked** ({e['ts']}) — {e['rung']}")
        elif e["kind"] == "spent":
            print(f"- **spent** ({e['ts']}) — {e.get('rung', '?')}")
        elif e["kind"] == "clear":
            print(f"- **cleared** ({e['ts']}) — {e.get('problem', '?')}")
        else:
            # An unknown kind is a record written by a newer version; printing
            # it beats crashing the reader that came to read the record.
            print(f"- **{e['kind']}** ({e['ts']})")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    action, rest = argv[0], argv[1:]
    path = record_path()
    if action == "start":
        path.touch()  # `start` means the record exists, not that a path was computed
        print(path)
        return 0
    if action == "show":
        return cmd_show(path)
    if action == "note":
        return cmd_note(path, rest)
    if action == "fail":
        return cmd_fail(path, rest)
    if action == "clear":
        return cmd_clear(path, rest)
    if action == "check":
        return cmd_check(path, rest)
    if action == "grant":
        return cmd_grant(path, rest)
    if action == "revoke":
        return cmd_revoke(path, rest)
    if action == "may":
        return cmd_may(path, rest)
    sys.exit(f"primeskills-run: unknown action {action!r}")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
