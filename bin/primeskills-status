#!/usr/bin/env python3
"""Print the one authoritative status block, generated from the repository.

Three different numbers get confused with each other, so they are printed apart.
What every session pays is the descriptions plus the pointer in the host's
always-loaded file -- `core/` itself is fetched on the first skill call, not
before. A single skill therefore costs that base plus one body; a flow costs the
base plus every body it can call, which is what its `calls` list is for.

Written because the documents drifted: three files claimed three different
skill counts, and support was described as four agents while two profiles were
unverified. Numbers that are typed by hand go stale; these are read.
"""
import importlib.machinery
import importlib.util
import re
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ALWAYS = ("PRINCIPLES.md", "GUARDRAILS.md", "OUTPUT.md")

# Role isolation, stated at the level it was actually verified.
SUPPORT = [
    ("Claude Code", "skills + core pointer in CLAUDE.md",
     "allowed-tools enforced; the shell is not covered (G7)"),
    ("Codex", "skills + core pointer in ~/.codex/AGENTS.md",
     "profile syntax correct; sandbox unusable here (bwrap fails in every mode)"),
    ("OpenCode", "skills + core in instructions + prime-analyst profile",
     "profile registered; permission edit/write deny"),
    ("Kimi", "extra_skill_dirs + core pointer + prime-analyst profile",
     "profile registered; Edit/Write/NotebookEdit denied"),
]


def words(p):
    return len(p.read_text(encoding="utf-8").split())


def bootstrap_words():
    """The pointer the installer writes into each host's always-loaded file."""
    spec = importlib.util.spec_from_loader(
        "primeskills_install",
        importlib.machinery.SourceFileLoader(
            "primeskills_install", str(ROOT / "bin" / "primeskills-install")))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod.bootstrap_text().split()


def expand(name, call_map, seen=None):
    """A flow that calls a flow pays for its chain too. Depth-first, no repeats."""
    seen = seen if seen is not None else []
    if name in seen:
        return seen
    seen.append(name)
    for child in call_map.get(name, []):
        expand(child, call_map, seen)
    return seen


def calls_optional_of(name, skills):
    for p in skills:
        if p.parent.name == name:
            return calls_of(p, "calls_optional")
    return []


def budget_of(path):
    m = re.search(r"^budget:\s*(\d+)", path.read_text(encoding="utf-8"), re.M)
    return int(m.group(1)) if m else 800


def calls_of(path, key="calls"):
    m = re.search(rf"^{key}:\s*\[(.*?)\]", path.read_text(encoding="utf-8"), re.M)
    return [n.strip() for n in m.group(1).split(",") if n.strip()] if m else []


def description(p):
    """The one line every agent carries for every skill, always."""
    m = re.search(r"^description:\s*(.+)$", p.read_text(encoding="utf-8"), re.M)
    return m.group(1) if m else ""


def body_words(p):
    text = p.read_text(encoding="utf-8")
    return len(re.sub(r"^---\n.*?\n---\n", "", text, count=1, flags=re.S).split())


def main():
    skills = sorted(ROOT.glob("skills/*/SKILL.md"))
    flows = [p for p in skills if "\ntier: flow" in p.read_text(encoding="utf-8")]
    core = sum(words(ROOT / "core" / f) for f in ALWAYS)
    on_demand = words(ROOT / "core" / "RATIONALIZATIONS.md") + \
        sum(words(p) for p in ROOT.glob("skills/*/ref/*.md"))
    total = sum(body_words(p) for p in skills)
    head = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--short", "HEAD"],
                          capture_output=True, text=True).stdout.strip()

    descs = sum(len(d.split()) for d in (description(p) for p in skills))
    pointer = len(bootstrap_words())
    bodies = {p.parent.name: body_words(p) for p in skills}
    always = descs + pointer
    base = always + core          # what the first skill call has cost by the time it starts
    singles = {n: w for n, w in bodies.items() if n not in {f.parent.name for f in flows}}

    print(f"primeskills @ {head}")
    print(f"  skills             {len(skills)} (of which flows: {len(flows)})")
    print(f"  always in context  {always} words "
          f"({len(skills)} descriptions {descs} + core pointer {pointer})")
    print(f"  core, once a session {core} words, read on the first skill call")
    print(f"  one skill          {base + min(singles.values())}"
          f" … {base + max(singles.values())} words "
          f"(base {base} + one body {min(singles.values())}–{max(singles.values())})")
    # C3 is enforced against the declared budget, not today's body: a skill may
    # grow into its budget without warning. Reporting the roomier number would
    # promise headroom the linter will refuse.
    budgets = {p.parent.name: budget_of(p) for p in skills
               if p.parent.name in singles}
    worst_name = max(budgets, key=budgets.get)
    print(f"  headroom           {3000 - base - budgets[worst_name]} words before "
          f"C3 refuses (budget of '{worst_name}' is {budgets[worst_name]})")
    print("  a flow             base + every body it can call:")
    everything = {p.parent.name: calls_of(p) for p in skills}
    certain = {k: [c for c in v if c not in calls_optional_of(k, skills)]
               for k, v in everything.items()}
    for f in sorted(flows, key=lambda p: p.parent.name):
        name = f.parent.name
        always, reached = expand(name, certain), expand(name, everything)
        usual = base + sum(bodies[n] for n in always)
        worst = base + sum(bodies[n] for n in reached)
        span = f"{usual}" if usual == worst else f"{usual}–{worst}"
        marks = " + ".join(n + ("?" if n not in always else "") for n in reached)
        print(f"      {name:<9} {span:>12}   {marks}")
    print(f"  whole set          {total + core} words, if every body were loaded")
    print(f"  refs, on demand    {on_demand} words")
    print("\n  agent        install                                        role isolation")
    for name, install, isolation in SUPPORT:
        print(f"  {name:<12} {install:<45} {isolation}")


if __name__ == "__main__":
    main()
