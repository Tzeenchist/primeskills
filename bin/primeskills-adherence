#!/usr/bin/env python3
"""Did the skills that ran actually get followed?

Six benchmark runs on 2026-08-17 established that scoring "which set wins" is
unanswerable at the sample sizes available, and that the one real invocation
ignored its skill's central invariant. So this measures the thing that can be
falsified: when a skill runs, are its own requirements met?

The reading is a correlation, not a cause. Behaviour inside a skill's span is
not necessarily produced by the skill -- `core/` demonstrably changed behaviour
with no skill invoked at all. What this can do is disprove "the set is helping":
a rule that is not followed is not helping.

Verdicts separate `unknown` from `n/a` on purpose. A test command with no
visible exit code is unknown; a change with no source edits cannot show a red
phase and is not applicable. Neither one enters the denominator.

    primeskills-adherence <session.jsonl>...
    primeskills-adherence --project /path/to/repo     # every session of that repo
    primeskills-adherence --all                       # every session, all four agents
    primeskills-adherence --all --kimi --codex        # narrow to named agents
    primeskills-adherence --newest                    # with either: newest session only
    primeskills-adherence --summary <files...>        # rates only
"""
import functools
import json
import importlib.util
import re
import shlex
import sys
from datetime import datetime
from pathlib import Path

HOME = Path.home()
CORE_FILES = ("PRINCIPLES.md", "GUARDRAILS.md", "OUTPUT.md")
WRITING_TOOLS = {"Edit", "Write", "NotebookEdit"}

TEST_PATH = re.compile(r"(^|/)(tests?|spec)[/_.]|test_[^/]*$|[^/]*_test\.[a-z]+$"
                       r"|\.test\.[a-z]+$|\.spec\.[a-z]+$|(^|/)tests?\.py$")
TEST_RUN = re.compile(r"\b(pytest|unittest|manage\.py\s+test|node\s+--test|npm\s+(run\s+)?test"
                      r"|jest|vitest|go\s+test|cargo\s+test)\b")
# A command that merely contains the word is not a run: `echo pytest` and
# `pytest || true` both matched, and both were counted as evidence of a suite.
# The reading was of a ritual, not of a fact.
NEUTERED = re.compile(r"^\s*(echo|printf|#)\b|\|\|\s*(true|:)\s*$|--collect-only\b|--help\b")
RECORDED = re.compile(r"\bprimeskills-run\s+note\b")
# Narrow on purpose: a checker that cries wolf gets ignored, which is worse
# than one that stays quiet.
DESTRUCTIVE = re.compile(r"\b(dropdb|DROP\s+(TABLE|DATABASE)|rm\s+-rf|git\s+clean\s+-[a-z]*f"
                         r"|TRUNCATE|manage\.py\s+(migrate|flush))\b", re.I)
TARGET_SHOWN = re.compile(r"\b(echo|printf)\b[^;]*\$|^\s*[A-Z_]{3,}=|--settings\b|--database\b|DATABASE_URL")
GIT_HYGIENE = re.compile(r"\bgit\s+(add\s+(-A|--all|\.)\b|push\s+[^|;]*--force(?!-with-lease)|push\s+[^|;]*-f\b|rebase\b|commit\s+[^|;]*--amend\b|reset\s+--hard\b|filter-repo\b)")
# Command text out of a session log lands in whatever reads this report — a
# terminal, a CI log, a pasted message. The log is not ours to leak, so the
# obvious shapes of a secret are blanked before printing. This is redaction,
# not sanitising: it lowers the odds, it does not make the output safe to
# publish blind.
SECRETS = [
    (re.compile(r'(?i)\b(authorization|api[_-]?key|token|secret|password|passwd)'
                r'(\s*[:=]\s*|\s+)(\S+)'), r"\1\2<вымарано>"),
    (re.compile(r"\b(gh[pousr]_[A-Za-z0-9]{16,}|sk-[A-Za-z0-9-]{16,}|xox[abprs]-[A-Za-z0-9-]{10,})"),
     "<вымарано>"),
    (re.compile(r"\b[A-Fa-f0-9]{40,}\b"), "<вымарано>"),
    (re.compile(r"\b[A-Za-z0-9+/]{40,}={0,2}\b"), "<вымарано>"),
]


def safe(text):
    out = str(text)
    for pattern, replacement in SECRETS:
        out = pattern.sub(replacement, out)
    return out


MUTATING_SHELL = re.compile(
    r"^(sed\b(?=.*\s(?:-i\S*|--in-place)\b)|tee\b|mv\b|cp\b|rm\b"
    r"|git\s+(commit|add|apply)\b)"
)


def load_top_level_parts():
    path = Path(__file__).resolve().parent.parent / "skills" / "fence" / "bin" / "check-commands.py"
    spec = importlib.util.spec_from_file_location("_primeskills_fence_commands", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module.top_level_parts


top_level_parts = load_top_level_parts()


def shell_tokens(part):
    lexer = shlex.shlex(part, posix=True, punctuation_chars="<>")
    lexer.whitespace_split = True
    lexer.commenters = ""
    return list(lexer)


def command_start(tokens):
    """Index of the program shell will execute, past assignments and wrappers."""
    i = 0
    while i < len(tokens) and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", tokens[i]):
        i += 1
    while i < len(tokens) and tokens[i] in ("command", "env", "nohup", "sudo", "time"):
        i += 1
        while i < len(tokens) and tokens[i].startswith("-"):
            i += 1
        while i < len(tokens) and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", tokens[i]):
            i += 1
    return i


def redirections(tokens):
    """Yield shell redirections as (fd, operator, target)."""
    for i, token in enumerate(tokens):
        if token not in (">", ">>") or i + 1 >= len(tokens):
            continue
        fd = tokens[i - 1] if i and tokens[i - 1].isdigit() else ""
        yield fd, token, tokens[i + 1]


def mutates_shell(command):
    for part in top_level_parts(command):
        try:
            tokens = shell_tokens(part)
        except ValueError:
            # An unreadable command cannot prove a write happened.
            continue
        if not tokens:
            continue
        redirects = list(redirections(tokens))
        if any(not target.startswith("&") and target != "/dev/null"
               for _fd, _op, target in redirects):
            return True

        start = command_start(tokens)
        if start < len(tokens):
            program = Path(tokens[start].lstrip("({!")).name.rstrip(")}")
            if program in ("sed", "tee", "mv", "cp", "rm", "git"):
                candidate = " ".join([program, *tokens[start + 1:]])
            else:
                candidate = program
            # Keep redirections in the classified view. Besides making the
            # distinction explicit, this makes restoring the old regex a real
            # mutation: `2>/dev/null` becomes a false violation again.
            candidate += " " + " ".join(f"{fd}{op} {target}"
                                         for fd, op, target in redirects)
            if MUTATING_SHELL.search(candidate.strip()):
                return True
    return False


# The set runs on four agents and one task moves between them: parallel work,
# a hand-off mid-session when tokens run out, a child task started elsewhere.
# Reading only Claude Code's transcripts would not merely gather data slowly --
# it would mis-read the work, because a task handed to another agent looks
# abandoned in the log it left behind.
SKILL_FILE = re.compile(r"(?:^|/)skills/([a-z0-9-]+)/SKILL\.md")


def call(calls, tool, skill=None, path="", cmd="", raw=None, inferred=False,
         call_id=None, returncode=None, skills=None):
    calls.append({"n": len(calls) + 1, "tool": tool, "skill": skill,
                  "skills": list(skills) if skills else ([skill] if skill else []),
                  "path": str(path or ""), "cmd": str(cmd or ""),
                  "inferred": inferred and bool(skill),
                  "raw": raw if raw is not None else str(cmd or path or ""),
                  "id": call_id, "returncode": returncode})


def explicit_exit(value):
    """An exit code only when the host recorded one, never from prose."""
    if isinstance(value, dict):
        for key in ("exit_code", "exitCode", "returncode", "returnCode"):
            if isinstance(value.get(key), int):
                return value[key]
        for item in value.values():
            found = explicit_exit(item)
            if found is not None:
                return found
    elif isinstance(value, list):
        for item in value:
            found = explicit_exit(item)
            if found is not None:
                return found
    return None


def output_text(value):
    if isinstance(value, str):
        return value
    if isinstance(value, list):
        return "\n".join(output_text(item) for item in value)
    if isinstance(value, dict):
        return str(value.get("text") or value.get("output") or "")
    return ""


def output_exits(value):
    text = output_text(value)
    codes = [int(n) for n in re.findall(
        r"(?:^|\n)(?:--- )?exit=(-?\d+)(?: ---)?(?=\n|$)", text)]
    if codes:
        return codes
    found = explicit_exit(value)
    return [found] if found is not None else []


SLASH = re.compile(r"<command-name>\s*/([a-z0-9-]+)\s*</command-name>")
SKILLS_DIR = Path(__file__).resolve().parent.parent / "skills"
_OUR_SKILLS = None


def our_skills():
    """Names of the set, read once from the checkout this program lives in."""
    global _OUR_SKILLS
    if _OUR_SKILLS is None:
        _OUR_SKILLS = ({d.name for d in SKILLS_DIR.iterdir()
                        if (d / "SKILL.md").is_file()}
                       if SKILLS_DIR.is_dir() else set())
    return _OUR_SKILLS


def message_text(content):
    """Claude Code writes a user turn as a string or as a list of blocks."""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return " ".join(i.get("text", "") for i in content
                        if isinstance(i, dict) and i.get("type") == "text")
    return ""


def flow_closure(name, seen=None):
    """A flow plus every skill it declares it can call, transitively."""
    seen = seen if seen is not None else set()
    if name in seen:
        return seen
    seen.add(name)
    for nxt in calls_of(name, SKILLS_DIR):
        flow_closure(nxt, seen)
    return seen


# A path a command *writes about* is not a path it read. `WRITING_TOOLS` catches
# the editors, but a shell redirect is a Bash call like any other, and since
# PS-073 counts every name in a command, one line of prose naming three skills
# became three invocations (PS-074). Two shapes cover the case without
# pretending to parse shell: a head that reads nothing, and the target of a
# redirect.
SAYS_NOTHING = re.compile(r"^\s*(?:echo|printf)\s", re.I)
REDIRECT_TARGET = re.compile(r"(?:>>?|\btee\b)\s*\S*")
SEGMENT = re.compile(r"\|\||&&|[;|]")


def spoken_of(cmd):
    """The part of a command that could have read a file.

    Judged per segment, not per line. Blanking the whole command when it
    mentions `echo` anywhere threw away the read in
    `cat skills/build/SKILL.md && echo ok` -- the same defect as the one this
    fixes, pointing the other way.
    """
    kept = []
    for piece in SEGMENT.split(str(cmd or "")):
        if SAYS_NOTHING.search(piece):
            continue
        kept.append(REDIRECT_TARGET.sub(" ", piece))
    return " ".join(kept)


def named_skills(path, cmd):
    """Every skill a single action loaded, in the order it named them.

    PS-073: this used to return the first match only. In Codex a flow arrives
    as one `exec_command` chaining the core files and the chain of skills with
    `&&`, so four bodies read together counted as one invocation -- the first
    name in the string -- and the other three vanished. Owner's ruling
    2026-08-30: four bodies read is four invocations.
    """
    seen = []
    for text in (path, spoken_of(cmd)):
        for hit in SKILL_FILE.finditer(text or ""):
            if hit.group(1) not in seen:
                seen.append(hit.group(1))
    return seen


def named_skill(path, cmd):
    """The first skill of an action, which is the one its span is keyed on."""
    names = named_skills(path, cmd)
    return names[0] if names else None


def load_claude(path):
    """Claude Code: one JSON object per line, tool_use inside message content.

    PS-073: a skill typed as `/lazy` is not a `tool_use` at all -- it arrives as
    a user turn carrying `<command-name>`. Counting only `tool_use` meant the
    way a person actually reaches for the set was worth nothing: a session with
    `/handon`, `/moderate` twice and `/close` twice reported two calls, the two
    made through the `Skill` tool. That is a bias against deliberate use, in a
    number the adoption criterion is read from.
    """
    calls = []
    by_id = {}
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                event = json.loads(line)
            except ValueError:
                continue
            message = event.get("message") or {}
            content = message.get("content")
            if message.get("role") == "user":
                # a slash command is stated, not inferred: never dropped later
                for name in SLASH.findall(message_text(content)):
                    if name in our_skills():
                        call(calls, "SlashCommand", name, "", "",
                             f"/{name}")
            if not isinstance(content, list):
                continue
            for item in content:
                if isinstance(item, dict) and item.get("type") == "tool_use":
                    data = item.get("input") or {}
                    call(calls, item.get("name", "?"), data.get("skill"),
                         data.get("file_path") or data.get("notebook_path") or "",
                         data.get("command") or "",
                         json.dumps(data, ensure_ascii=False), call_id=item.get("id"))
                    if item.get("id"):
                        by_id[item["id"]] = calls[-1]
                elif isinstance(item, dict) and item.get("type") == "tool_result":
                    target = by_id.get(item.get("tool_use_id"))
                    if target is not None:
                        code = explicit_exit(item)
                        target["returncode"] = explicit_exit(event) if code is None else code
    return calls


def load_codex(path):
    """Codex: rollout log. Shell work arrives as a `custom_tool_call` named
    `exec`, whose input is a snippet calling tools.exec_command({"cmd": ...});
    edits arrive as `apply_patch`."""
    calls = []
    pending = {}
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                event = json.loads(line)
            except ValueError:
                continue
            payload = event.get("payload") or {}
            if event.get("type") != "response_item":
                continue
            if payload.get("type") == "custom_tool_call_output":
                indexes = pending.get(payload.get("call_id"), [])
                codes = output_exits(payload.get("output"))
                if len(codes) == len(indexes):
                    for index, code in zip(indexes, codes):
                        calls[index]["returncode"] = code
                continue
            if payload.get("type") != "custom_tool_call":
                continue
            raw = str(payload.get("input") or "")
            if payload.get("name") == "apply_patch":
                target = re.search(r'"(?:path|file_path)"\s*:\s*"([^"]+)"', raw)
                call(calls, "Edit", None, target.group(1) if target else "", "", raw[:400])
                continue
            # The input is a JavaScript snippet, so the key is bare (`cmd:"..."`)
            # and one snippet may hold several commands under Promise.all. Each
            # command is one action here, or a session of eight batched calls
            # reads as eight actions instead of one.
            found = re.findall(r'\bcmd\s*:\s*"((?:[^"\\]|\\.)*)"', raw)
            indexes = []
            for piece in found or [""]:
                try:
                    cmd = json.loads('"' + piece + '"') if piece else ""
                except ValueError:
                    cmd = piece
                names = named_skills("", cmd)
                call(calls, "Bash", names[0] if names else None, "", cmd,
                     raw[:400], inferred=True, skills=names)
                indexes.append(len(calls) - 1)
            if payload.get("call_id"):
                pending[payload["call_id"]] = indexes
    return calls


def load_kimi(path):
    """Kimi: wire log of one agent. `tool.call` events already carry the same
    tool vocabulary Claude uses (Bash, Edit, Read, Write, Grep, Glob)."""
    calls = []
    by_id = {}
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                event = json.loads(line)
            except ValueError:
                continue
            inner = event.get("event") or {}
            if inner.get("type") == "tool.result":
                target = by_id.get(inner.get("toolCallId"))
                if target is not None:
                    target["returncode"] = explicit_exit(inner.get("result"))
                continue
            if inner.get("type") != "tool.call":
                continue
            args = inner.get("args") or {}
            target = args.get("file_path") or args.get("filePath") or args.get("path") or ""
            cmd = args.get("command") or args.get("cmd") or ""
            name = inner.get("name", "?")
            names = [] if name in WRITING_TOOLS else named_skills(str(target), str(cmd))
            call(calls, name, names[0] if names else None, target, cmd,
                 json.dumps(args, ensure_ascii=False)[:400], inferred=True,
                 call_id=inner.get("toolCallId"), skills=names)
            if inner.get("toolCallId"):
                by_id[inner["toolCallId"]] = calls[-1]
    return calls


TOOL_ALIASES = {"bash": "Bash", "edit": "Edit", "write": "Write", "read": "Read",
                "grep": "Grep", "glob": "Glob", "patch": "Edit",
                "todowrite": "TodoWrite", "task": "Task"}


def load_opencode(db, session_id):
    """OpenCode keeps sessions in SQLite; each tool call is a `part` row whose
    JSON carries the tool name and its input."""
    import sqlite3
    calls = []
    con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    rows = con.execute("select data from part where session_id = ? order by time_created, id",
                       (session_id,))
    for (data,) in rows:
        try:
            part = json.loads(data)
        except ValueError:
            continue
        if part.get("type") != "tool":
            continue
        state = part.get("state") or {}
        args = state.get("input") or {}
        name = TOOL_ALIASES.get(str(part.get("tool", "")).lower(), part.get("tool", "?"))
        target = args.get("filePath") or args.get("file_path") or args.get("path") or ""
        cmd = args.get("command") or ""
        names = [] if name in WRITING_TOOLS else named_skills(str(target), str(cmd))
        call(calls, name, names[0] if names else None, target, cmd,
             json.dumps(args, ensure_ascii=False)[:400], inferred=True,
             returncode=explicit_exit(state), skills=names)
    con.close()
    return calls


# Reading five different SKILL.md files in one session is studying the set, not
# using it. Below that, a read is the only trace an invocation leaves outside
# Claude Code.
STUDY_THRESHOLD = 5


def drop_non_invocations(calls):
    """Separate using the set from working on it.

    Outside Claude Code an invocation is inferred from a read of SKILL.md, and
    two kinds of session read those files without invoking anything: the ones
    that edit them, and the external reviews that read all of them in a row.
    Left in, they turned 27 real invocations into 265 and would have made the
    adoption number say the opposite of the truth — the first version of this
    reader did exactly that. Explicit invocations (Claude Code's Skill tool)
    are never dropped: they are stated, not inferred.
    """
    editing = any(c["tool"] in WRITING_TOOLS and SKILL_FILE.search(c["path"] + c["cmd"])
                  for c in calls)
    distinct = {n for c in calls if c.get("inferred") for n in c.get("skills", [])}
    if not editing and len(distinct) < STUDY_THRESHOLD:
        return calls
    # PS-073: a flow explains its own reads. `lazy` declares a chain of about
    # nineteen bodies, so every honest run of it crossed this threshold and was
    # thrown away as study -- the rule punished exactly the sessions that used
    # the most of the set. Reads that stay inside one flow's declared closure
    # are that flow running, not somebody paging through the directory.
    if not editing:
        for name in sorted(distinct):
            if calls_of(name, SKILLS_DIR) and distinct <= flow_closure(name):
                return calls
    for c in calls:
        if c.get("inferred"):
            c["skill"] = None
            c["skills"] = []
    return calls


def load_calls(path):
    """Every tool call in order, whichever agent wrote the log."""
    text = str(path)
    if "/.codex/sessions/" in text or "rollout-" in Path(text).name:
        return drop_non_invocations(load_codex(path))
    if Path(text).name == "wire.jsonl" or "/.kimi-code/sessions/" in text:
        return drop_non_invocations(load_kimi(path))
    if "::" in text:
        db, session_id = text.split("::", 1)
        return drop_non_invocations(load_opencode(db, session_id))
    return load_claude(path)


# How many tool calls after an invocation still read comfortably as that
# skill's work. "Until the next skill call" swallowed 123 and 294 unrelated
# actions in the first live sample and charged their violations to `autoplan`
# and `baby` -- a measurement of the window, not of behaviour.
#
# Truncating at the cap was tried first and was worse: the one real violation
# on record sits at call #68 of a long span, and cutting the window hid it. So
# nothing is dropped. A span past the cap is marked, its verdicts are counted
# separately, and the reader is told which numbers rest on a long window.
SPAN_CAP = 40


def spans(calls):
    """A skill owns what follows its invocation, up to the next one or the cap."""
    # Claude Code has an explicit Skill tool; the other three hosts leave only
    # the read of SKILL.md, which the loaders turn into the same field. Keying
    # on the field rather than on the tool name is what makes one task visible
    # across the agents it passed through.
    marks = [c for c in calls if c["skill"]]
    out = []
    for i, mark in enumerate(marks):
        end = marks[i + 1]["n"] if i + 1 < len(marks) else len(calls) + 1
        owned = [c for c in calls if mark["n"] < c["n"] < end]
        out.append({
            "skill": mark["skill"],
            "at": mark["n"],
            "calls": owned,
            "long": len(owned) > SPAN_CAP,
        })
    return out


def is_test_file(path):
    return bool(path) and bool(TEST_PATH.search(path))


def calls_of(skill, skills_dir):
    """The chain a flow declares, in the order it runs. `calls_optional` only
    marks which of these are conditional, so order comes from one list."""
    md = skills_dir / skill / "SKILL.md"
    if not md.is_file():
        return []
    m = re.search(r"^calls:\s*\[(.*?)\]", md.read_text(encoding="utf-8"), re.M)
    return [x.strip() for x in m.group(1).split(",") if x.strip()] if m else []


def role_of(skill, skills_dir):
    md = skills_dir / skill / "SKILL.md"
    if not md.is_file():
        return None
    m = re.search(r"^role:\s*(\S+)", md.read_text(encoding="utf-8"), re.M)
    return m.group(1) if m else None


# --- checks -----------------------------------------------------------------
# Each returns (verdict, detail); verdict is "ok", "violated" or None for n/a.

def check_red_phase(span):
    """build: a failing test comes before the code that makes it pass."""
    edits = [c for c in span["calls"] if c["tool"] in WRITING_TOOLS]
    tests = [c for c in edits if is_test_file(c["path"])]
    source = [c for c in edits if not is_test_file(c["path"])]
    if not tests or not source:
        return None, "правок обоих видов нет — по порядку не различить"
    first_test, first_source = tests[0]["n"], source[0]["n"]
    if first_test > first_source:
        return "violated", f"код #{first_source} раньше теста #{first_test}"
    # Order alone proves the files were touched in sequence, not that anything
    # was ever red. A red phase is a run that failed, so require a run between
    # the test and the code it is supposed to have failed against.
    runs = [c for c in span["calls"]
            if first_test < c["n"] < first_source and ran_tests(c)]
    between = [c["n"] for c in runs]
    if not between:
        return "violated", (f"тест #{first_test} раньше кода #{first_source}, "
                            f"но прогона между ними не было — красноты никто не видел")
    failed = next((c for c in runs if c["returncode"] not in (None, 0)), None)
    if failed:
        return "ok", f"тест #{first_test}, прогон #{failed['n']}, код #{first_source}"
    if any(c["returncode"] is None for c in runs):
        return "unknown", f"у прогона #{between[0]} код возврата в журнале не виден"
    return "violated", f"прогон #{between[0]} завершился кодом 0 — красной фазы не было"


def ran_tests(c):
    return (c["tool"] == "Bash" and TEST_RUN.search(c["cmd"])
            and not NEUTERED.search(c["cmd"].strip()))


def check_suite_ran(span):
    """verify: something was actually run, and preferably written down."""
    for c in span["calls"]:
        if c["tool"] == "Bash" and RECORDED.search(c["cmd"]):
            return "ok", f"#{c['n']}: записан в run-запись"
    runs = [c for c in span["calls"] if ran_tests(c)]
    passed = next((c for c in runs if c["returncode"] == 0), None)
    if passed:
        return "ok", f"#{passed['n']}: код 0, {safe(passed['cmd'].splitlines()[0][:50])}"
    failed = next((c for c in runs if c["returncode"] not in (None, 0)), None)
    if failed and all(c["returncode"] is not None for c in runs):
        return "violated", f"#{failed['n']}: код {failed['returncode']}"
    if runs:
        return "unknown", f"у прогона #{runs[0]['n']} код возврата в журнале не виден"
    return "violated", "прогона тестов в пролёте нет"


def check_repro_first(span):
    """debug: reproduce before touching anything."""
    edits = [c for c in span["calls"] if c["tool"] in WRITING_TOOLS]
    if not edits:
        return None, "правок не было"
    first_edit = edits[0]["n"]
    for c in span["calls"]:
        if c["n"] < first_edit and ran_tests(c):
            return "ok", f"прогон #{c['n']} до правки #{first_edit}"
    return "violated", f"первая правка #{first_edit} без прогона до неё"


def check_read_only(span):
    """G16: the skill does not touch the work. A `reports` skill may still write
    its verdict under .primeskills/ -- a verdict nobody can read is not one."""
    for c in span["calls"]:
        if c["tool"] in WRITING_TOOLS:
            if "/.primeskills/" in c["path"]:
                continue
            return "violated", f"#{c['n']} {c['tool']} {c['path']}"
        if c["tool"] == "Bash" and mutates_shell(c["cmd"]):
            return "violated", f"#{c['n']} shell: {c['cmd'].splitlines()[0][:50]}"
    return "ok", "записи в пролёте нет"


def check_diff_before_commit(span):
    """land, G17: the change is read before it is committed."""
    commits = [c for c in span["calls"]
               if c["tool"] == "Bash" and re.search(r"\bgit\s+commit\b", c["cmd"])]
    if not commits:
        return None, "коммитов в пролёте нет"
    first = commits[0]["n"]
    for c in span["calls"]:
        if c["n"] < first and c["tool"] == "Bash" and re.search(r"\bgit\s+diff\b", c["cmd"]):
            return "ok", f"дифф #{c['n']} до коммита #{first}"
    return "violated", f"коммит #{first} без чтения диффа"



def check_git_hygiene(span):
    """land, merge, G14: never `git add -A`, never force, never rewrite.

    The cheapest check in the set and the one with the worst failure mode:
    `git add -A` has twice pulled foreign work into a commit in this project's
    own history, which is why the rule exists at all.
    """
    for c in span["calls"]:
        if c["tool"] == "Bash":
            m = GIT_HYGIENE.search(c["cmd"])
            if m:
                return "violated", f"#{c['n']}: {m.group(0)}"
    commits = [c for c in span["calls"]
               if c["tool"] == "Bash" and re.search(r"\bgit\s+(commit|push|add)\b", c["cmd"])]
    if not commits:
        return None, "git в пролёте не вызывался"
    return "ok", f"{len(commits)} обращений к git, запрещённого нет"


def check_checkpoint_in_repo(span):
    """handoff: the checkpoint has to survive another machine, so it goes into
    the repository -- a home directory does not travel."""
    writes = [c for c in span["calls"] if c["tool"] in WRITING_TOOLS and c["path"]]
    if not writes:
        return None, "файл чекпоинта не писался"
    for c in writes:
        if str(HOME) in c["path"] and "/.primeskills/" not in c["path"]:
            return "violated", f"#{c['n']} в домашний каталог: {c['path']}"
    inside = [c for c in writes if "/.primeskills/handoff/" in c["path"]]
    if inside:
        return "ok", inside[0]["path"]
    return None, "путь не опознан как чекпоинт"


def check_green_by_editing_test(span):
    """verify: a test is never edited to turn a build green.

    Detected as the shape it leaves: a failing run, then a test file edited with
    no source touched, then a run. Innocent explanations exist -- the test was
    genuinely wrong -- which is why this reports rather than accuses.
    """
    runs = [c for c in span["calls"] if c["tool"] == "Bash" and TEST_RUN.search(c["cmd"])]
    if len(runs) < 2:
        return None, "меньше двух прогонов — форма не различима"
    first, last = runs[0]["n"], runs[-1]["n"]
    between = [c for c in span["calls"] if first < c["n"] < last and c["tool"] in WRITING_TOOLS]
    if not between:
        return None, "между прогонами правок нет"
    if all(is_test_file(c["path"]) for c in between):
        if runs[0]["returncode"] is None or runs[-1]["returncode"] is None:
            return "unknown", "коды возврата прогонов в журнале не видны"
        if runs[0]["returncode"] == 0 or runs[-1]["returncode"] != 0:
            return None, "форма падение → правка теста → зелень не подтверждена"
        return "violated", ("между прогонами правились только тесты: "
                            + ", ".join(c["path"].split("/")[-1] for c in between[:3]))
    return "ok", "между прогонами правился и код"


def check_flow_order(span, call_map, later_skills):
    """A flow declares its chain in `calls:`; the calls that follow must respect
    that order. Skipping forward to salvage progress is the failure every flow
    names in its own stop conditions."""
    declared = call_map.get(span["skill"]) or []
    if not declared or not later_skills:
        return None, "вложенных вызовов нет"
    seen = [s for s in later_skills if s in declared]
    if not seen:
        return None, "ни одно объявленное звено не вызвано"
    order = [declared.index(s) for s in seen]
    if order == sorted(order):
        return "ok", " → ".join(seen)
    return "violated", f"порядок {' → '.join(seen)} против объявленного {' → '.join(declared)}"


PER_SKILL = {
    "build": [("красная фаза (P7, TDD)", check_red_phase),
              ("гигиена git (G14)", check_git_hygiene)],
    "cycle": [("красная фаза (P7, TDD)", check_red_phase)],
    "verify": [("прогон состоялся (G4)", check_suite_ran),
               ("зелень не куплена правкой теста", check_green_by_editing_test)],
    "debug": [("воспроизведение до правки (P3)", check_repro_first)],
    "land": [("дифф прочитан до коммита (G17)", check_diff_before_commit),
             ("гигиена git (G14)", check_git_hygiene)],
    "merge": [("гигиена git (G14)", check_git_hygiene)],
    "revise": [("гигиена git (G14)", check_git_hygiene)],
    "handoff": [("чекпоинт в репозитории, не в доме", check_checkpoint_in_repo)],
}


def targets_in(cmd):
    """Words that could name what a command is about to destroy."""
    return set(re.findall(r"\$\{?[A-Za-z_][A-Za-z0-9_]*\}?|\b[a-z][a-z0-9_]{3,}\b", cmd))


def check_target_resolved(calls):
    """G8, session-wide: a destructive command resolves its target first.

    The print counts only when it is the immediately preceding command and names
    the same target as the destruction. Both looser rules fail: crediting any
    earlier print passes a bare `dropdb prod_orders` whenever some unrelated line
    echoed a variable, and crediting none punishes the careful two-step the
    guardrail describes -- resolve, print, then act.
    """
    findings = []
    bash = [c for c in calls if c["tool"] == "Bash"]
    for i, c in enumerate(bash):
        if not DESTRUCTIVE.search(c["cmd"]):
            continue
        shown = bool(TARGET_SHOWN.search(c["cmd"]))
        how = "цель напечатана в самой команде"
        if not shown and i:
            prev = bash[i - 1]["cmd"]
            if re.search(r"\b(echo|printf)\b", prev):
                shared = targets_in(prev) & targets_in(c["cmd"])
                shared -= {"echo", "printf", "dropdb", "database", "table"}
                if shared:
                    shown = True
                    how = f"цель напечатана предыдущей командой: {sorted(shared)[0]}"
        findings.append(("ok" if shown else "violated", c["n"],
                         c["cmd"].splitlines()[0][:55] + (f" — {how}" if shown else "")))
    return findings


def report(path, skills_dir, quiet=False):
    calls = load_calls(path)
    found = spans(calls)
    # One action can load several bodies (PS-073). Each is an invocation and is
    # counted; the stretch of work that follows is still one stretch, so it is
    # judged once, under the first name the action gave.
    invocations = [n for c in calls for n in c.get("skills", [])]
    core_at = next((c["n"] for c in calls
                    if any(f in c["raw"] for f in CORE_FILES)), None)
    # Two questions, two tallies. Mixing them produced one number that answered
    # neither: 138 of 151 checks were the session-wide G8, so "adherence 56%"
    # was really a measurement of destructive-target hygiene wearing the name of
    # skill adherence.
    tally = {"ok": 0, "violated": 0, "unknown": 0, "na": 0, "far": 0}
    guard = {"ok": 0, "violated": 0, "na": 0}
    by_rule = {}

    if not quiet:
        print(f"\n{path}")
        print(f"  вызовов инструментов: {len(calls)}   "
              f"вызовов скиллов: {len(invocations)}")
        print(f"  core/ прочитан: {'действие #' + str(core_at) if core_at else 'нет'}")

    order = [s["skill"] for s in found]
    for i, span in enumerate(found):
        checks = list(PER_SKILL.get(span["skill"], []))
        # `exercises` writes through the application on purpose (G16); holding
        # it to the read-only check reported its own design as a violation.
        if role_of(span["skill"], skills_dir) in ("read-only", "reports"):
            checks.append(("не пишет (G16)", check_read_only))
        declared = calls_of(span["skill"], skills_dir)
        if declared:
            call_map = {span["skill"]: declared}
            later = order[i + 1:]
            checks.append(("порядок цепочки",
                           lambda sp, cm=call_map, lt=later: check_flow_order(sp, cm, lt)))
        if not quiet:
            tail = (f" — длиннее отсечки в {SPAN_CAP}, приписано с оговоркой"
                    if span.get("long") else "")
            print(f"  · {span['skill']} (вызван #{span['at']}, "
                  f"{len(span['calls'])} действий в пролёте{tail})")
        if not checks and not quiet:
            print("      проверяемых инвариантов нет")
        for name, fn in checks:
            verdict, detail = fn(span)
            tally["na" if verdict is None else verdict] += 1
            slot = by_rule.setdefault(name, {"ok": 0, "violated": 0,
                                             "unknown": 0, "na": 0})
            slot["na" if verdict is None else verdict] += 1
            if verdict is not None and span.get("long"):
                tally["far"] = tally.get("far", 0) + 1
            if not quiet:
                mark = {"ok": "ok  ", "violated": "НАРУШЕН",
                        "unknown": "неизв", None: "н/п "}[verdict]
                print(f"      [{mark}] {name} — {safe(detail)}")

    g17 = check_target_resolved(calls)
    for verdict, n, cmd in g17:
        guard[verdict] += 1
        if not quiet:
            mark = "ok  " if verdict == "ok" else "НАРУШЕН"
            print(f"  [{mark}] цель разрешена до разрушения (G8) — #{n}: {safe(cmd)}")

    return {"skills": invocations, "core_at": core_at,
            "tally": tally, "guard": guard, "by_rule": by_rule,
            "on_set": wrote_into_the_set(calls)}


def sessions_of(project_dir, newest_only):
    """Every session of a project, oldest first.

    `--all` used to mean "every project, newest session each" -- which read 3
    files out of 44 on the machine it was written on. A statistic gathered
    through that window is quietly low, and the flag that produces it is named
    --all. Breadth is the default now; --newest asks for the old behaviour.
    """
    files = sorted(project_dir.glob("*.jsonl"), key=lambda p: p.stat().st_mtime)
    return files[-1:] if (newest_only and files) else files


def claude_sessions(newest_only, project=None):
    root = HOME / ".claude" / "projects"
    dirs = [root / str(project.resolve()).replace("/", "-")] if project else \
        (sorted(root.iterdir()) if root.is_dir() else [])
    out = []
    for d in dirs:
        if d.is_dir():
            out += sessions_of(d, newest_only)
    return out


def codex_sessions(newest_only, project=None):
    root = HOME / ".codex" / "sessions"
    files = sorted(root.rglob("rollout-*.jsonl"), key=lambda p: p.stat().st_mtime) \
        if root.is_dir() else []
    if project:
        files = [f for f in files if session_cwd(f) == str(project.resolve())]
    return files[-1:] if (newest_only and files) else files


def session_cwd(path):
    """Codex records the working directory in its first line."""
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            first = json.loads(fh.readline())
        return (first.get("payload") or {}).get("cwd")
    except (OSError, ValueError):
        return None


def kimi_sessions(newest_only, project=None):
    root = HOME / ".kimi-code" / "sessions"
    files = sorted(root.glob("*/session_*/agents/*/wire.jsonl"),
                   key=lambda p: p.stat().st_mtime) if root.is_dir() else []
    if project:
        keep = []
        for f in files:
            state = f.parents[2] / "state.json"
            try:
                if json.loads(state.read_text(encoding="utf-8")).get("cwd") == str(project.resolve()):
                    keep.append(f)
            except (OSError, ValueError):
                continue
        files = keep
    return files[-1:] if (newest_only and files) else files


def opencode_sessions(newest_only, project=None):
    """One database, many sessions: each is addressed as `<db>::<session id>`."""
    db = HOME / ".local" / "share" / "opencode" / "opencode.db"
    if not db.is_file():
        return []
    import sqlite3
    con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    try:
        rows = list(con.execute("select id, directory from session order by id"))
    except sqlite3.Error:
        return []
    finally:
        con.close()
    ids = [sid for sid, directory in rows
           if not project or directory == str(project.resolve())]
    labels = [Path(f"{db}::{sid}") for sid in ids]
    return labels[-1:] if (newest_only and labels) else labels


# One task crosses agents: it is picked up elsewhere when tokens run out, and
# child tasks are started alongside. Sessions are grouped into a task by the
# directory they worked in plus a gap in time — because PS-009 counts tasks,
# not sessions, and applying it to sessions would answer a different question
# with the right-looking number.
TASK_GAP = 6 * 3600  # seconds between sessions that still read as one task


def as_seconds(value):
    """Timestamps arrive as seconds, milliseconds, or ISO text depending on the
    host — and one host uses more than one of those."""
    if isinstance(value, (int, float)):
        return value / 1000 if value > 10 ** 11 else float(value)
    if isinstance(value, str):
        try:
            return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
        except ValueError:
            return 0.0
    return 0.0


def session_facts(path):
    """(agent, working directory, first timestamp, last timestamp)."""
    text = str(path)
    if "::" in text:
        db, sid = text.split("::", 1)
        import sqlite3
        row = times = None
        try:
            con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
            try:
                row = con.execute("select directory from session where id = ?",
                                  (sid,)).fetchone()
            except sqlite3.Error:
                row = None          # a database without the session table still has parts
            times = con.execute("select min(time_created), max(time_created) from part "
                                "where session_id = ?", (sid,)).fetchone()
            con.close()
        except sqlite3.Error:
            pass
        return ("opencode", row[0] if row else None,
                as_seconds(times[0] if times else 0), as_seconds(times[1] if times else 0))
    if Path(text).name == "wire.jsonl":
        state = Path(text).parents[2] / "state.json"
        try:
            data = json.loads(state.read_text(encoding="utf-8"))
            return ("kimi", data.get("cwd"),
                    as_seconds(data.get("createdAt")), as_seconds(data.get("updatedAt")))
        except (OSError, ValueError):
            return ("kimi", None, 0, 0)
    stamp = Path(text).stat().st_mtime if Path(text).exists() else 0
    if "/.codex/sessions/" in text or Path(text).name.startswith("rollout-"):
        return ("codex", session_cwd(path), stamp, stamp)
    cwd = None
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                try:
                    cwd = (json.loads(line) or {}).get("cwd")
                except ValueError:
                    continue
                if cwd:
                    break
    except OSError:
        pass
    return ("claude", cwd, stamp, stamp)


def flow_marks(directory):
    """Every `flow` note in a tree's run record, as (skill, when).

    PS-073: three of the four hosts log no invocation event, and a flow whose
    bodies the host hands to the agent leaves no trace even there -- `lazy` ran
    many times and was never once visible. The record is the one place that
    does not depend on what the host chose to log, so `core/` asks a flow to
    write itself down on its first step and this reads it back.
    """
    root = Path(directory or "") / ".primeskills" / "run"
    if not root.is_dir():
        return []
    out = []
    for path in sorted(root.glob("*.jsonl")):
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        for line in text.splitlines():
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if e.get("kind") != "note" or e.get("stage") != "flow":
                continue
            name, when = e.get("skill"), as_seconds(e.get("ts"))
            if name and when:
                out.append((name, when))
    return out


def assign_marks(tasks):
    """One note, one task: the nearest task of that tree, never two.

    Attributed per task and not per session, because for Claude Code and Codex
    a session's window is a single mtime and a note would land in every session
    of the directory at once. And assigned by nearest rather than by a window,
    because windows on neighbouring tasks overlap -- counting a note twice
    would inflate the very number this was written to repair.
    """
    out = {}
    by_dir = {}
    for index, (directory, items) in enumerate(tasks):
        by_dir.setdefault(directory, []).append((index, items))
    for directory, entries in by_dir.items():
        marks = flow_marks(directory)
        if not marks:
            continue
        spans = [(index, min(i[3] for i in items), max(i[4] for i in items))
                 for index, items in entries]
        for name, when in marks:
            nearest, best = None, None
            for index, first, last in spans:
                gap = 0 if first <= when <= last else min(abs(when - first),
                                                          abs(when - last))
                if best is None or gap < best:
                    nearest, best = index, gap
            if nearest is not None and best <= TASK_GAP:
                out.setdefault(nearest, []).append(name)
    return out


def tasks_of(paths):
    """Group sessions into tasks: same directory, no gap longer than TASK_GAP."""
    facts = [(p,) + session_facts(p) for p in paths]
    by_dir = {}
    for item in facts:
        by_dir.setdefault(item[2] or "(каталог неизвестен)", []).append(item)
    out = []
    for directory, items in sorted(by_dir.items()):
        items.sort(key=lambda i: i[3])
        group = []
        for item in items:
            if group and item[3] - group[-1][4] > TASK_GAP:
                out.append((directory, group))
                group = []
            group.append(item)
        if group:
            out.append((directory, group))
    return out


@functools.lru_cache(maxsize=None)
def is_set_checkout(directory):
    """Is this directory a copy of the set itself?

    A session run inside the set measures work *on* it, not work *with* it, and
    the two belong on different sides of the PS-009 criterion. Worktrees count:
    they are the same repository under another path, which is exactly how the
    parallel agents run. Checked by what the directory contains rather than by
    git, because the directory may be gone by the time it is read.
    """
    try:
        root = Path(directory).resolve()
    except (OSError, ValueError):
        return False
    return ((root / "bin" / "primeskills-status").exists()
            and (root / "core" / "PRINCIPLES.md").exists())


def wrote_into_the_set(calls):
    """Did this session edit the set, wherever it happened to be standing?

    Asking `is_set_checkout` about the session's working directory answers a
    different question than the one PS-009 needs. On 2026-08-20 a whole day of
    editing this repository was counted as work *with* the set, because the
    sessions ran from `$HOME` and reached the repository by absolute path:
    `is_set_checkout("/home/admin")` is False and always will be. The report
    said "0 of 14 tasks were inside the set" on a day when at least one was.

    So the judgement moves from where the session stood to what it wrote. Two
    signals, because shell edits carry no structured path: an absolute write
    path with a checkout above it, and the `skills/<name>/SKILL.md` shape
    anywhere in the path or the command text -- the same signal `real_calls`
    already trusts to tell editing the set from using it.
    """
    for c in calls:
        if c["tool"] not in WRITING_TOOLS and not c["cmd"]:
            continue
        if SKILL_FILE.search(c["path"] + c["cmd"]):
            return True
        target = c["path"]
        if not target.startswith("/"):
            continue
        for parent in Path(target).parents:
            if is_set_checkout(str(parent)):
                return True
    return False


AGENTS = {"claude": claude_sessions, "codex": codex_sessions,
          "kimi": kimi_sessions, "opencode": opencode_sessions}


def main(argv):
    skills_dir = Path(__file__).resolve().parent.parent / "skills"
    quiet = "--summary" in argv
    newest_only = "--newest" in argv
    argv = [a for a in argv if a not in ("--summary", "--newest")]
    paths = []

    wanted = [a[2:] for a in argv if a.startswith("--") and a[2:] in AGENTS] or list(AGENTS)
    argv = [a for a in argv if a[2:] not in AGENTS]

    if "--all" in argv:
        for agent in wanted:
            paths += AGENTS[agent](newest_only)
    elif "--project" in argv:
        project = Path(argv[argv.index("--project") + 1])
        for agent in wanted:
            paths += AGENTS[agent](newest_only, project)
        if not paths:
            sys.exit(f"нет сессий для {project.resolve()} ни у одного агента")
    else:
        paths = [Path(a) for a in argv if a.endswith(".jsonl") or "::" in a]

    if not paths:
        print(__doc__)
        return 0

    total = {"ok": 0, "violated": 0, "unknown": 0, "na": 0, "far": 0}
    guard = {"ok": 0, "violated": 0, "na": 0}
    rules = {}
    invoked, sessions_with_core = [], 0
    seen = {}
    for p in paths:
        r = seen[str(p)] = report(p, skills_dir, quiet)
        invoked += r["skills"]
        sessions_with_core += bool(r["core_at"])
        for k, v in r["tally"].items():
            total[k] += v
        for k, v in r["guard"].items():
            guard[k] += v
        for name, counts in r["by_rule"].items():
            slot = rules.setdefault(name, {"ok": 0, "violated": 0,
                                           "unknown": 0, "na": 0})
            for k, v in counts.items():
                slot[k] += v

    def share(counts):
        applicable = counts["ok"] + counts["violated"]
        return applicable, (f"{100 * counts['ok'] // applicable}%" if applicable else "—")

    # `session_facts` and `report` are both re-read per session otherwise, and
    # a sweep of 661 sessions pays for it twice.
    # Two denominators, because they answer two questions. "Any skill at all"
    # says how often a set -- ours, gstack's, the host's -- gets reached for.
    # Only this set's own skills can be evidence about this set, and PS-009
    # asks its question about those. Until 2026-08-20 the first number wore the
    # second's name: `gstack-ship`, `browse` and `artifact-design` were counted
    # as "the set took part", and the criterion would have been read off a
    # denominator that has nothing to do with the set being judged.
    own = ({d.name for d in skills_dir.iterdir() if d.is_dir()}
           if skills_dir.is_dir() else set())
    grouped = tasks_of(paths)
    crossing = [t for t in grouped if len({i[1] for i in t[1]}) > 1]

    # Traces first, so `names_of` below reads a table that already exists.
    traced = {}
    for index, marks in assign_marks(grouped).items():
        # A flow the host already recorded is not a second invocation: in Claude
        # Code `/lazy` is both a slash call and a note. Only the surplus counts.
        already = [n for i in grouped[index][1]
                   for n in seen.get(str(i[0]), {}).get("skills", [])]
        extra = []
        for name in sorted(set(marks)):
            extra += [name] * max(0, marks.count(name) - already.count(name))
        if extra:
            traced[index] = extra
            invoked += extra

    def names_of(items, index=None):
        logged = [n for i in items for n in seen.get(str(i[0]), {}).get("skills", [])]
        # ... plus what the flows wrote down about themselves, which is the
        # only evidence in the hosts that log nothing (PS-073).
        return logged + (traced.get(index, []) if index is not None else [])

    any_skill = sum(1 for k, (_d, items) in enumerate(grouped)
                    if names_of(items, k))
    ours = [(k, d, items) for k, (d, items) in enumerate(grouped)
            if own & set(names_of(items, k))]
    on_the_set = [d for _k, d, items in ours
                  if is_set_checkout(d)
                  or any(seen.get(str(i[0]), {}).get("on_set") for i in items)]
    called = sorted(own & {n for k, _d, items in ours for n in names_of(items, k)})

    print(f"\nсессий: {len(paths)}   с чтением core/: {sessions_with_core}")
    print(f"задач: {len(grouped)} (сессии одного каталога в пределах "
          f"{TASK_GAP // 3600} ч), из них {len(crossing)} прошли через несколько "
          f"агентов")
    print(f"задач с вызовом любого скилла: {any_skill}; из них с вызовом этого "
          f"набора: {len(ours)}, и {len(on_the_set)} из них шли внутри самого "
          f"набора — это работа над ним, а не применение его")
    print(f"навыков набора вызвано хоть раз: {len(called)} из {len(own)}"
          + (f" ({', '.join(called)})" if called else ""))
    print(f"вызовов скиллов: {len(invoked)}"
          + (f" ({', '.join(sorted(set(invoked)))})" if invoked else ""))

    applicable, rate = share(total)
    print(f"\n## Соблюдение вызванных скиллов")
    print(f"проверок: {applicable} применимых, {total['unknown']} неизвестных, "
          f"{total['na']} неприменимых")
    print(f"соблюдено: {total['ok']}, нарушено: {total['violated']}, доля {rate}")
    if rules:
        print("по инвариантам — что именно ломается:")
        for name, counts in sorted(rules.items(),
                                   key=lambda kv: -kv[1]["violated"]):
            print(f"  {counts['violated']:>3} нарушено, {counts['ok']:>3} соблюдено"
                  f"{', ' + str(counts['unknown']) + ' неизвестно' if counts['unknown'] else ''}"
                  f"{', ' + str(counts['na']) + ' н/п' if counts['na'] else ''}"
                  f" — {name}")
    if total.get("far"):
        print(f"из них {total['far']} на пролётах длиннее {SPAN_CAP} действий — "
              f"там скиллу приписано и то, что могло быть посторонней работой; "
              f"эти смотреть глазами, прежде чем считать")

    g_applicable, g_rate = share(guard)
    print(f"\n## Ограничитель G8 (по всей сессии, вне зависимости от скиллов)")
    print(f"проверок: {g_applicable}")
    print(f"соблюдено: {guard['ok']}, нарушено: {guard['violated']}, доля {g_rate}")
    print("это база поведения, а не мера набора: она набрана и там, где набор "
          "не участвовал")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
